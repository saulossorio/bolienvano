---
// Home: who the artist is and what he paints, the most recent works and the
// exhibitions. The large detail links to the featured artwork.
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid.astro';
import { t, artworkTitles, exhibitionTexts } from '../content/index.js';
import { artworks } from '../data/artworks.js';
import { exhibitions } from '../data/exhibitions.js';
import { pageUrl } from '../lib/urls.js';
import { image } from '../lib/images.js';

const hero = image('site', 'brochure-full-min.jpg');
const featured = artworks.find((a) => a.slug === 'invisible');
const recent = artworks.slice(0, 6);
---
<Base current="home" image={hero}>
  <section class="hero container">
    <div class="text">
      <span class="eyebrow">{t.home.eyebrow}</span>
      <h1>{t.home.headline}</h1>
      <p class="lead">{t.home.intro}</p>
      <div class="actions">
        <a class="button" href={pageUrl('gallery')}>{t.home.worksButton}</a>
        <a class="button ghost" href={pageUrl('about')}>{t.home.aboutButton}</a>
      </div>
    </div>

    <a class="art" href={pageUrl(`gallery/${featured.slug}`)}>
      <Picture
        src={hero}
        alt={artworkTitles[featured.slug]}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[600, 900, 1300, 1800]}
        sizes="(max-width: 899px) 92vw, 55vw"
        loading="eager"
        fetchpriority="high"
      />
      <span class="credit">{t.home.featuredLabel}: <em>{artworkTitles[featured.slug]}</em>, {featured.year}</span>
    </a>
  </section>

  <section class="section container">
    <div class="section-head">
      <h2>{t.home.recent}</h2>
      <a class="more" href={pageUrl('gallery')}>{t.home.allWorks}</a>
    </div>
    <WorkGrid items={recent} eagerCount={0} />
  </section>

  <section class="section container">
    <div class="section-head">
      <h2>{t.home.exhibitions}</h2>
      <a class="more" href={pageUrl('exhibitions')}>{t.home.allExhibitions}</a>
    </div>
    <ul class="shows">
      {exhibitions.map((e) => {
        const text = exhibitionTexts[e.slug];
        return (
          <li>
            <a href={pageUrl(`exhibitions/${e.slug}`)}>
              <span class="show-year">{e.date.slice(0, 4)}</span>
              <span class="show-title">{text.title}</span>
              <span class="show-venue">{text.venue}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
</Base>

<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 5rem); align-items: center;
    padding-block: clamp(2rem, 6vw, 5rem) 0;
  }
  .hero h1 { font-size: clamp(3rem, 7vw, 6.25rem); line-height: .95; margin-bottom: 1.5rem; }
  .lead { max-width: 34ch; font-size: 1.125rem; color: var(--muted); margin-bottom: 2rem; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; }

  .art { display: block; text-decoration: none; }
  .art :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%; }
  .credit { display: block; margin-top: .75rem; font-size: .8125rem; color: var(--muted); }
  .art:hover .credit { color: var(--ink); }

  .shows { margin: 0; padding: 0; list-style: none; }
  .shows a {
    display: grid; grid-template-columns: 6rem minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem 2rem; align-items: baseline;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  /* Hover nudges the text, not the padding, so nothing reflows */
  .shows a > * { transition: transform var(--fast) var(--ease); }
  .shows a:hover > * { transform: translateX(.75rem); }
  .show-year { font-size: .8125rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .show-title { font-family: var(--serif); font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: 1.1; }
  .show-venue { font-size: .875rem; color: var(--muted); }

  @media (max-width: 899px) {
    .hero { grid-template-columns: 1fr; }
    .art { order: -1; }
    .art :global(img) { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 699px) {
    .shows a { grid-template-columns: 1fr; gap: .25rem; }
  }
</style>
