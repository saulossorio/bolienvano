---
// Home: one large image that leads to the featured artwork.
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { t, artworkTitles } from '../content/index.js';
import { pageUrl } from '../lib/urls.js';
import { image } from '../lib/images.js';

const hero = image('site', 'brochure-full-min.jpg');
const featured = 'invisible';
---
<Base current="home" image={hero}>
  <h1 class="visually-hidden">{t.site.name}</h1>
  <a class="hero" href={pageUrl(`gallery/${featured}`)}>
    <Picture
      src={hero}
      alt={artworkTitles[featured]}
      formats={['avif']}
      fallbackFormat="webp"
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </a>
</Base>

<style>
  .hero { position: relative; display: block; height: 70vh; overflow: hidden; }
  .hero :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
