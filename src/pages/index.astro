---
// Home: one work, whole and as large as the screen allows, with its museum label
// and a small link to all the works. Nothing else, like a single painting on a
// gallery wall. Each visit shows a different one of the works listed below that is
// still available, picked at random (never the same as last time). A work marked
// as sold in src/data/artworks.js leaves the home page by itself.
// Without JavaScript the first one shows.
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { t, artworkTitles } from '../content/index.js';
import { artworks } from '../data/artworks.js';
import { pageUrl } from '../lib/urls.js';
import { artworkImages } from '../lib/images.js';

// The works that can appear on the home page. They should all be photos of the
// work alone (not on a wall), so the page always looks the same.
const slugs = [
  'humana', 'paciencia', 'ultimo-recurso', 'incertidumbre', 'nadie', 'luchas',
  'cavilaciones-matutinas', 'espera', 'invisible', 'cargando-un-fantasma', 'pesada', 'crisis',
];

const works = slugs
  .map((slug) => artworks.find((a) => a.slug === slug))
  .filter((artwork) => artwork.status === 'available')
  .map((artwork) => ({ ...artwork, title: artworkTitles[artwork.slug], src: artworkImages(artwork.slug)[0].src }));
---
<Base current="home" image={works[0].src}>
  <h1 class="visually-hidden">{t.site.name}</h1>

  <div class="home container">
    {works.map((w, i) => (
      <figure class:list={['work', { 'is-shown': i === 0 }]} data-work>
        <a href={pageUrl(`gallery/${w.slug}`)}>
          <Picture
            src={w.src}
            alt={w.title}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[600, 900, 1300]}
            sizes="(max-width: 767px) 92vw, 70vh"
            loading="lazy"
          />
        </a>
        <figcaption class="label">
          <span><em>{w.title}</em>, {w.year}</span>
          <span>{t.media[w.medium]}, {w.size}</span>
        </figcaption>
      </figure>
    ))}
    <a class="all" href={pageUrl('gallery')}>{t.home.allWorks} <span aria-hidden="true">→</span></a>
  </div>

  <!-- Runs right away, before the page is painted, so no other work flashes first -->
  <script is:inline>
    (() => {
      const works = document.querySelectorAll('[data-work]');
      let last = -1;
      try { last = Number(localStorage.getItem('home-work') ?? -1); } catch {}
      let pick = Math.floor(Math.random() * Math.max(works.length - 1, 1));
      if (works.length > 1 && last >= 0 && last < works.length && pick >= last) pick += 1;   // skip the one shown last time
      works[0].classList.remove('is-shown');
      works[pick].classList.add('is-shown');
      const img = works[pick].querySelector('img');
      img.loading = 'eager';
      img.fetchPriority = 'high';
      try { localStorage.setItem('home-work', pick); } catch {}
    })();
  </script>
</Base>

<style>
  /* The work, its label and the link fill the screen below the bar, centered */
  .home {
    --label: 2.5rem; --link: 1.5rem;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    min-height: calc(100svh - var(--bar));
    padding-block: var(--space-m) var(--space-l);
  }
  .work { display: none; margin: 0; }
  .work.is-shown { display: flex; flex-direction: column; align-items: center; gap: var(--space-m); }
  .work a { display: block; }
  .work :global(img) {
    width: auto; max-width: 100%;
    max-height: calc(100svh - var(--bar) - var(--space-m) * 2 - var(--space-l) * 2 - var(--label) - var(--link));
    object-fit: contain;
    mix-blend-mode: darken;   /* white paper edges turn wall-colored */
    /* and the faint scan border around the paper melts into the page */
    mask-image: linear-gradient(to right, transparent, #000 3%, #000 97%, transparent),
                linear-gradient(to bottom, transparent, #000 3%, #000 97%, transparent);
    mask-composite: intersect;
    animation: appear var(--slow) var(--ease) both;
  }
  /* The work fades in and settles, the label follows a moment later */
  @keyframes appear { from { opacity: 0; transform: scale(1.015); } }
  .label {
    display: flex; flex-direction: column; align-items: center; height: var(--label); justify-content: center;
    font-size: var(--text-xs); line-height: 1.5; color: var(--muted); text-align: center;
    animation: rise var(--slow) var(--ease) .25s both;
  }
  @keyframes rise { from { opacity: 0; transform: translateY(.35rem); } }
  .label em { color: var(--ink); }

  /* Small link to all the works, the same size as the label */
  .all {
    display: inline-flex; align-items: center; gap: .35em; height: var(--link); margin-top: var(--space-l);
    font-size: var(--text-xs); letter-spacing: var(--tracking); text-transform: uppercase; text-decoration: none;
    color: var(--muted); transition: color var(--fast) var(--ease);
    animation: rise var(--slow) var(--ease) .4s both;
  }
  .all span { transition: transform var(--fast) var(--ease); }
  .all:hover { color: var(--ink); }
  .all:hover span { transform: translateX(.25rem); }

  /* Phones: the work sits near the top and uses the full width */
  @media (max-width: 767px) {
    .home { justify-content: flex-start; min-height: 0; padding-block: var(--space-l) var(--space-xl); }
    .work :global(img) { width: 100%; max-height: none; }
  }
</style>
