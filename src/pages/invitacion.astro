---
// Invitation card for the "Hiperconciencia" opening (2022), in Spanish as printed.
// Rebuilt from the original Webflow interaction: the white cover ("Invitación" and a
// hand) opens like a book on hover, click or tap; the drawing is printed on the back of
// the cover, and the whole card slides so the open spread stays centred.
// Desktop opens sideways (rotateY), phones open upwards (rotateX). 0.8s, as the original.
import { Picture, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { t } from '../content/index.js';
import { image } from '../lib/images.js';

const inv = t.invitation;
const cover = image('site', 'IMG_6652.jpg');
const seal = image('site', 'Screen-Shot-2022-07-16-at-21.45.37.svg');
---
<Base title={inv.title} description={inv.description} path="invitacion" image={cover} translated={false}>
  <section class="invitation" lang="es">
    <div class="card" data-card>
      <div class="details">
        <span class="spine" aria-hidden="true"></span>
        <p><strong>{inv.host}</strong><br />{inv.intro}</p>
        <p class="event">{inv.event}</p>
        <p class="name">{inv.name}</p>
        <p><a href={inv.placeUrl} target="_blank" rel="noopener noreferrer">{inv.place[0]}<br />{inv.place[1]}</a></p>
        <p>{inv.date[0]}<br />{inv.date[1]}</p>
      </div>

      <button class="cover" type="button" aria-expanded="false" data-cover>
        <span class="front">
          <span class="cover-text">{inv.title}</span>
          <Image src={seal} alt="" width={32} height={32} />
          <span class="visually-hidden">{inv.open}</span>
        </span>
        <Picture
          pictureAttributes={{ class: 'back' }}
          src={cover}
          alt=""
          formats={['avif']}
          fallbackFormat="webp"
          widths={[480, 900]}
          sizes="(max-width: 767px) 90vw, 450px"
          loading="eager"
        />
        <span class="spine" aria-hidden="true"></span>
      </button>
    </div>

    <div class="organizers">
      <p>{inv.organizers}</p>
      <div class="logos">
        <Image src={image('site', 'mac.png')} alt={inv.macAlt} width={96} />
        <Image src={image('site', 'VERDE.png')} alt={inv.cityAlt} width={112} />
      </div>
    </div>
  </section>
</Base>

<script>
  // Opens on hover (with a mouse) and on click/tap/keyboard; closes when the pointer
  // leaves or on a second click.
  document.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
    const cover = card.querySelector<HTMLButtonElement>('[data-cover]')!;
    const set = (open: boolean) => {
      card.classList.toggle('open', open);
      cover.setAttribute('aria-expanded', String(open));
    };
    const hover = matchMedia('(hover: hover) and (pointer: fine)');
    card.addEventListener('pointerenter', () => hover.matches && set(true));
    card.addEventListener('pointerleave', () => hover.matches && set(false));
    cover.addEventListener('click', () => set(hover.matches || !card.classList.contains('open')));
  });
</script>

<style>
  /* Sizes reproduce the printed card, so this page keeps its own values. */
  .invitation {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rem;
    min-height: 80vh; padding: 2rem 1rem;
    perspective: 2000px;
    overflow-x: clip;
  }

  .card {
    --open: cubic-bezier(.61, 1, .88, 1);   /* Webflow outSine */
    --close: cubic-bezier(0, .55, .45, 1);  /* Webflow outCirc */
    position: relative;
    width: min(450px, 90vw); aspect-ratio: 1;
    transform-style: preserve-3d;
    transition: transform .8s var(--close);
  }
  .card.open { transform: translateX(50%); transition-timing-function: var(--open); }

  .details {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; justify-content: center; align-items: flex-start;
    padding: 20px;
    background: #fff;
    box-shadow: 3px 0 40px 20px rgb(0 0 0 / 7%);
    font-size: .75rem; line-height: 1rem; color: #131313;
  }
  .details p { margin: .25rem 0 0; }
  .details a { color: inherit; text-decoration: none; }
  .event { font-size: 1rem; font-weight: 700; margin-top: .5rem !important; }
  .name { font-size: 1.5rem; margin: 1rem 0 !important; }

  .cover {
    position: absolute; inset: 0; z-index: 2;
    padding: 0; border: 0; cursor: pointer; font: inherit; color: #131313;
    background: #fff;
    box-shadow: -3px 0 40px 20px rgb(0 0 0 / 7%);
    transform-origin: 0 50%;
    transform-style: preserve-3d;
    transition: transform .8s var(--open);
  }
  .open .cover { transform: rotateY(-179.9deg); }

  /* Front: white, "Invitación" and the hand */
  .front {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .25rem;
    backface-visibility: hidden;
  }
  .cover-text { font-size: 1.5rem; line-height: 2; }

  /* Back: the drawing, the right way round once the cover is open */
  .cover :global(.back) { position: absolute; inset: 0; transform: rotateY(180deg); backface-visibility: hidden; }
  .cover :global(.back img) { width: 100%; height: 100%; object-fit: cover; }

  /* Thin shade along the fold */
  .spine {
    position: absolute; top: 0; bottom: 0; left: 0; width: 5px;
    background: linear-gradient(90deg, rgb(0 0 0 / 10%), rgb(255 255 255 / 0) 75%);
  }

  .organizers { display: flex; flex-direction: column; align-items: center; font-size: .75rem; }
  .logos { display: flex; align-items: center; gap: 1rem; }
  .logos :global(img:first-child) { width: 6rem; }
  .logos :global(img:last-child) { width: 7rem; }

  /* Phones: the cover opens upwards and the card slides down */
  @media (max-width: 767px) {
    .card { margin-block: min(225px, 45vw); }   /* room for the open card above and below */
    .card.open { transform: translateY(50%); }
    .cover { transform-origin: 50% 0; }
    .open .cover { transform: rotateX(179.9deg); }
    .cover :global(.back) { transform: rotateX(180deg); }
    .spine { width: auto; height: 5px; right: 0; bottom: auto;
             background: linear-gradient(180deg, rgb(0 0 0 / 10%), rgb(255 255 255 / 0) 75%); }
  }
  /* The fold is the point of this page, so it plays even with "Reduce motion" on
     (as the original did); this beats the site-wide reduced-motion rule. */
  @media (prefers-reduced-motion: reduce) {
    .card, .cover { transition-duration: .8s !important; }
  }
</style>
