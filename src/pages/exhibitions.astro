---
// List of exhibitions, newest first. The whole row links to the exhibition page.
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { t, exhibitionTexts } from '../content/index.js';
import { exhibitions } from '../data/exhibitions.js';
import { pageUrl } from '../lib/urls.js';
import { image, artworkImages } from '../lib/images.js';
import { formatDate } from '../lib/dates.js';
---
<Base title={t.exhibitions.title} description={t.exhibitions.description} path="exhibitions" current="exhibitions">
  <div class="container">
    <header class="intro">
      <h1>{t.exhibitions.title}</h1>
    </header>

    <ul class="list">
      {exhibitions.map((e, i) => {
        const text = exhibitionTexts[e.slug];
        return (
          <li class="row">
            <Picture
              src={e.coverWork ? artworkImages(e.coverWork)[0].src : image('exhibitions', e.cover)}
              alt=""
              formats={['avif']}
              fallbackFormat="webp"
              widths={[500, 800, 1100]}
              sizes="(max-width: 767px) 92vw, 50vw"
              class:list={['cover', { work: e.coverWork }]}
              loading={i === 0 ? 'eager' : 'lazy'}
            />
            <div class="text">
              <p class="eyebrow"><time datetime={e.date}>{formatDate(e.date)}</time></p>
              <h2><a href={pageUrl(`exhibitions/${e.slug}`)}>{text.title}</a></h2>
              <p class="venue">{text.venue}</p>
              <p class="summary">{text.summary}</p>
              <span class="more" aria-hidden="true">{t.exhibitions.read}</span>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</Base>

<style>
  .intro { padding-block: var(--space-xl) var(--space-l); }

  .list { margin: 0; padding: 0; list-style: none; }

  .row {
    position: relative;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-xl); align-items: center;
    padding-block: var(--space-row);
    border-top: 1px solid var(--line);
  }
  .row :global(.cover) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: opacity var(--fast) var(--ease); }
  .row:hover :global(.cover) { opacity: .85; }
  /* An artwork as cover is shown whole, on the wall color, never cropped */
  .row :global(.cover.work) { object-fit: contain; mix-blend-mode: var(--blend); }

  .text h2 { margin-bottom: var(--space-2xs); }
  /* The title link covers the whole row, so the row is one big click target */
  h2 a { text-decoration: none; }
  h2 a::after { content: ''; position: absolute; inset: 0; }
  .row:hover h2 a { text-decoration: underline; text-decoration-thickness: 1px; }
  .venue { font-size: var(--text-sm); color: var(--muted); }
  .summary { max-width: 46ch; }

  @media (max-width: 767px) {
    .row { grid-template-columns: 1fr; }
  }
</style>
