---
// Contact form (sent by contact.php on the server).
// Without JavaScript the form posts normally; with it, it sends in the background
// and shows the thank-you or error message in place.
import Base from '../layouts/Base.astro';
import { t } from '../content/index.js';
import { assetUrl } from '../lib/urls.js';

---
<Base title={t.contact.title} description={t.contact.description} path="contact" current="contact">
  <div class="container contact">
    <div class="side">
      <span class="eyebrow">{t.contact.title}</span>
      <h1>{t.contact.heading}</h1>
      <p class="lead">{t.contact.intro}</p>
      <p class="where">{t.contact.mapTitle}</p>
    </div>

    <div>
      <form class="form" action={assetUrl('contact.php')} method="post" data-contact-form>
        <div class="row2">
          <div class="field">
            <label for="name">{t.contact.name}</label>
            <input id="name" name="name" type="text" maxlength="256" autocomplete="name" />
          </div>
          <div class="field">
            <label for="email">{t.contact.email}</label>
            <input id="email" name="email" type="email" maxlength="256" autocomplete="email" required />
          </div>
        </div>

        <div class="field">
          <label for="subject">{t.contact.subject}</label>
          <input id="subject" name="subject" type="text" maxlength="256" />
        </div>

        <div class="field">
          <label for="message">{t.contact.message}</label>
          <textarea id="message" name="message" maxlength="5000" required></textarea>
        </div>

        {/* Spam trap: hidden from people, bots fill it in and get ignored */}
        <div class="trap" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <button class="button" type="submit" data-sending={t.contact.sending}>{t.contact.submit}</button>
      </form>

      <p class="done" role="status" hidden>{t.contact.done}</p>
      <p class="fail" role="alert" hidden>{t.contact.fail}</p>
    </div>
  </div>
</Base>

<script>
  const form = document.querySelector('[data-contact-form]');
  if (form) {
    const button = form.querySelector('button[type="submit"]');
    const done = document.querySelector('.done');
    const fail = document.querySelector('.fail');
    const label = button.textContent;

    // Coming back from contact.php after a submit without JavaScript
    const params = new URLSearchParams(location.search);
    if (params.has('sent')) { form.hidden = true; done.hidden = false; }
    if (params.has('error')) fail.hidden = false;

    // Coming from an artwork: its title is already in the subject
    const subject = params.get('subject');
    if (subject) form.querySelector('#subject').value = subject.slice(0, 256);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      button.textContent = button.dataset.sending;
      fail.hidden = true;
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { 'X-Requested-With': 'fetch' },
        });
        if (!response.ok) throw new Error(String(response.status));
        form.hidden = true;
        done.hidden = false;
      } catch {
        fail.hidden = false;
      } finally {
        button.disabled = false;
        button.textContent = label;
      }
    });
  }
</script>

<style>
  .contact {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 6rem); align-items: start;
    padding-block: clamp(3rem, 7vw, 6rem) 0;
  }
  .lead { max-width: 30ch; font-size: 1.125rem; color: var(--muted); }
  .where { font-size: .875rem; color: var(--muted); }

  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.5rem; }
  .field { margin-bottom: 1.5rem; }
  label {
    display: block; margin-bottom: .4rem;
    font-size: .75rem; font-weight: 500; letter-spacing: .1em; text-transform: uppercase;
    color: var(--muted);
  }
  input, textarea {
    display: block; width: 100%;
    padding: .8rem 1rem;
    border: 1px solid var(--line); border-radius: 0;
    background: var(--paper);
    font: inherit; color: var(--ink);
    transition: border-color var(--fast) var(--ease);
  }
  input:focus, textarea:focus { outline: none; border-color: var(--ink); }
  textarea { min-height: 10rem; resize: vertical; }

  .trap { position: absolute; left: -9999px; }

  .button:disabled { opacity: .6; cursor: wait; }

  .done, .fail { padding: 1.5rem; }
  .done { background: var(--paper); border-left: 2px solid var(--ink); }
  .fail { background: #f7e4e0; border-left: 2px solid var(--accent); }

  @media (max-width: 899px) {
    .contact { grid-template-columns: 1fr; }
  }
  @media (max-width: 599px) {
    .row2 { grid-template-columns: 1fr; }
  }
</style>
