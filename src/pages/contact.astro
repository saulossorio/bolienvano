---
// Contact form (sent by contact.php on the server). Built only from the site's shared
// patterns: .eyebrow labels, .input fields, the reason to write as .choice options,
// one .button. The design system page shows each of them.
// Without JavaScript the form posts normally; with it, it sends in the background
// and shows the thank-you or error message in place.
// Coming from an artwork (?subject=Title (year)), "Buy a work" is picked and the
// work is named above the message.
import Base from '../layouts/Base.astro';
import { t } from '../content/index.js';
import { assetUrl } from '../lib/urls.js';

const c = t.contact;
---
<Base title={c.title} description={c.description} path="contact" current="contact">
  <div class="container contact">
    <div class="side">
      <h1>{c.title}</h1>
      <p class="lead">{c.intro}</p>
    </div>

    <div>
      <form class="form" action={assetUrl('contact.php')} method="post" data-contact-form>
        <fieldset class="topics">
          <legend class="eyebrow">{c.topic}</legend>
          <div class="choices">
            {Object.entries(c.topics).map(([value, label], i) => (
              <label class="choice">
                <input type="radio" name="topic" value={value} checked={i === 0} />
                {label}
              </label>
            ))}
          </div>
          <p class="work" hidden data-work>{c.work} <em></em></p>
          <input type="hidden" name="work" />
        </fieldset>

        <div class="row2">
          <div class="field">
            <label class="eyebrow" for="name">{c.name}</label>
            <input class="input" id="name" name="name" type="text" maxlength="256" autocomplete="name" />
          </div>
          <div class="field">
            <label class="eyebrow" for="email">{c.email} <span aria-hidden="true">*</span><span class="visually-hidden">({c.required})</span></label>
            <input class="input" id="email" name="email" type="email" maxlength="256" autocomplete="email" required />
          </div>
        </div>

        <div class="field">
          <label class="eyebrow" for="message">{c.message} <span aria-hidden="true">*</span><span class="visually-hidden">({c.required})</span></label>
          <textarea class="input" id="message" name="message" maxlength="5000" rows="5" required></textarea>
        </div>

        {/* Spam trap: hidden from people, bots fill it in and get ignored */}
        <div class="trap" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="send">
          <button class="button" type="submit" data-sending={c.sending}>{c.submit}</button>
          <p class="privacy">{c.privacy}</p>
        </div>
      </form>

      <p class="done" role="status" tabindex="-1" hidden>{c.done}</p>
      <p class="fail" role="alert" hidden>{c.fail}</p>
    </div>
  </div>
</Base>

<script>
  const form = document.querySelector('[data-contact-form]');
  if (form) {
    const button = form.querySelector('button[type="submit"]');
    const done = document.querySelector('.done');
    const fail = document.querySelector('.fail');
    const label = button.textContent;

    // Coming back from contact.php after a submit without JavaScript
    const params = new URLSearchParams(location.search);
    if (params.has('sent')) { form.hidden = true; done.hidden = false; }
    if (params.has('error')) fail.hidden = false;

    // Coming from an artwork: about buying it, with the work named above the message
    const work = params.get('subject')?.slice(0, 256);
    if (work) {
      form.querySelector('input[value="buy"]').checked = true;
      form.elements.work.value = work;
      const line = form.querySelector('[data-work]');
      line.querySelector('em').textContent = work;
      line.hidden = false;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      button.textContent = button.dataset.sending;
      fail.hidden = true;
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { 'X-Requested-With': 'fetch' },
        });
        if (!response.ok) throw new Error(String(response.status));
        form.hidden = true;
        done.hidden = false;
        done.focus();
      } catch {
        fail.hidden = false;
      } finally {
        button.disabled = false;
        button.textContent = label;
      }
    });
  }
</script>

<style>
  .contact {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl); align-items: start;
    padding-block: var(--space-xl) 0;
  }
  .side h1 { margin-bottom: var(--space-m); }
  .lead { max-width: 30ch; font-size: var(--text-md); color: var(--muted); }

  /* Labels are .eyebrow (global.css) */
  .eyebrow { margin-bottom: var(--space-2xs); }

  /* Reason to write: a row of .choice options (global.css), with more air above
     them than a field label so the question reads first */
  .topics { margin: 0 0 var(--space-l); padding: 0; border: 0; }
  .topics legend { padding: 0; margin-bottom: var(--space-s); }
  .choices { display: flex; flex-wrap: wrap; gap: var(--space-2xs); }

  .work { margin: var(--space-m) 0 0; font-size: var(--text-sm); color: var(--muted); }
  .work em { color: var(--ink); }

  /* Fields are .input (global.css) */
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 var(--space-l); }
  .field { margin-bottom: var(--space-l); }

  .trap { position: absolute; left: -9999px; }

  .send { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-s) var(--space-m); }
  .button:disabled { opacity: .6; cursor: wait; }
  .privacy { margin: 0; font-size: var(--text-xs); color: var(--muted); }

  .done { font-size: var(--text-md); }
  .done:focus { outline: none; }
  .fail { margin-top: var(--space-m); font-size: var(--text-sm); color: var(--accent); }

  @media (max-width: 899px) {
    .contact { grid-template-columns: 1fr; gap: var(--space-l); }
  }
  @media (max-width: 599px) {
    .row2 { grid-template-columns: 1fr; }
  }
</style>
