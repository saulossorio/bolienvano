---
// Contact form (sent by contact.php on the server) and map.
// Without JavaScript the form posts normally; with it, it sends in the background
// and shows the thank-you or error message in place.
import Base from '../layouts/Base.astro';
import { t } from '../content/index.js';
import { assetUrl } from '../lib/urls.js';

// Curitiba, Brazil (OpenStreetMap, no API key or cookies)
const map = 'https://www.openstreetmap.org/export/embed.html?bbox=-49.40%2C-25.52%2C-49.14%2C-25.36&layer=mapnik&marker=-25.4372%2C-49.2700';
---
<Base title={t.contact.title} description={t.contact.description} path="contact" current="contact">
  <section class="section">
    <div class="container">
      <h1 class="heading">{t.contact.heading}</h1>

      <form class="form" action={assetUrl('contact.php')} method="post" data-contact-form>
        <label for="name">{t.contact.name}</label>
        <input id="name" name="name" type="text" maxlength="256" autocomplete="name" />

        <label for="email">{t.contact.email}</label>
        <input id="email" name="email" type="email" maxlength="256" autocomplete="email" required />

        <label for="subject">{t.contact.subject}</label>
        <input id="subject" name="subject" type="text" maxlength="256" />

        <label for="message">{t.contact.message}</label>
        <textarea id="message" name="message" maxlength="5000" required></textarea>

        {/* Spam trap: hidden from people, bots fill it in and get ignored */}
        <div class="trap" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="actions">
          <button class="button" type="submit" data-sending={t.contact.sending}>{t.contact.submit}</button>
        </div>
      </form>

      <p class="done" role="status" hidden>{t.contact.done}</p>
      <p class="fail" role="alert" hidden>{t.contact.fail}</p>
    </div>
  </section>

  <section class="section map">
    <div class="container">
      <h2 class="map-heading">{t.contact.mapHeading}</h2>
    </div>
    <iframe src={map} title={t.contact.mapTitle} loading="lazy"></iframe>
  </section>
</Base>

<script>
  const form = document.querySelector('[data-contact-form]');
  if (form) {
    const button = form.querySelector('button[type="submit"]');
    const done = document.querySelector('.done');
    const fail = document.querySelector('.fail');
    const label = button.textContent;

    // Coming back from contact.php after a submit without JavaScript
    const params = new URLSearchParams(location.search);
    if (params.has('sent')) { form.hidden = true; done.hidden = false; }
    if (params.has('error')) fail.hidden = false;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      button.textContent = button.dataset.sending;
      fail.hidden = true;
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { 'X-Requested-With': 'fetch' },
        });
        if (!response.ok) throw new Error(String(response.status));
        form.hidden = true;
        done.hidden = false;
      } catch {
        fail.hidden = false;
      } finally {
        button.disabled = false;
        button.textContent = label;
      }
    });
  }
</script>

<style>
  .heading { font-size: 1.5rem; margin-bottom: 2rem; }

  label { display: block; margin-bottom: 5px; font-weight: 700; }
  input, textarea {
    display: block; width: 100%;
    margin-bottom: 10px; padding: 8px 12px;
    border: 1px solid #ccc; background: var(--white);
    font: inherit; font-size: 14px; line-height: 1.43; color: #333;
  }
  input { height: 38px; }
  textarea { min-height: 6rem; resize: vertical; }

  .trap { position: absolute; left: -9999px; }

  .actions { display: flex; justify-content: center; margin-top: 2rem; }
  .button:disabled { opacity: .6; cursor: wait; }

  .done, .fail { padding: 20px; text-align: center; }
  .done { background: #ddd; }
  .fail { background: #ffdede; }

  .map { padding-inline: 0; }
  .map-heading { font-size: 1.5rem; margin-bottom: 2rem; padding-inline: 2rem; }
  .map iframe { display: block; width: 100%; height: 400px; border: 0; }
</style>
