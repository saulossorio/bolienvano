---
// Works: every artwork on one page, grouped by year, newest first.
// A bar under the header stays visible while scrolling: jump to a year, or show
// only the works for sale ("Available only", also opened by gallery.html#available).
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid.astro';
import YearNav from '../components/YearNav.astro';
import { t } from '../content/index.js';
import { artworks, years } from '../data/artworks.js';

const availableCount = artworks.filter((a) => a.status === 'available').length;
---
<Base title={t.gallery.title} description={t.gallery.description} path="gallery" current="gallery">
  <div class="container">
    <header class="intro">
      <h1>{t.gallery.title}</h1>
    </header>
  </div>

  <div class="toolbar" id="available">
    <div class="container bar">
      <YearNav anchors />
      <button class="filter line-link" type="button" aria-pressed="false" data-filter hidden>
        <span class="dot" aria-hidden="true"></span>
        {t.gallery.availableOnly} <span class="n">({availableCount})</span>
      </button>
    </div>
  </div>

  <div class="container" data-works>
    {years.map(({ year }, i) => {
      const items = artworks.filter((a) => a.year === year);
      return (
        <section class="year" id={`y${year}`} aria-labelledby={`h${year}`}>
          <div class="section-head">
            <h2 id={`h${year}`}>{year}</h2>
            <span class="count">{items.length} {t.gallery.works}</span>
          </div>
          <WorkGrid items={items} eagerCount={i === 0 ? 3 : 0} priority={i === 0} />
        </section>
      );
    })}

    <p class="empty" hidden data-empty>{t.gallery.noneAvailable}</p>
  </div>
</Base>

<script>
  // "Available only": hides works that are not for sale and years left empty.
  const button = document.querySelector('[data-filter]');
  const works = document.querySelector('[data-works]');
  const empty = document.querySelector('[data-empty]');
  button.hidden = false;

  function apply(on) {
    button.setAttribute('aria-pressed', String(on));
    works.classList.toggle('only-available', on);
    let any = false;
    works.querySelectorAll('.year').forEach((section) => {
      const visible = !on || section.querySelector('[data-status="available"]');
      section.hidden = !visible;
      document.querySelector(`.years a[href="#${section.id}"]`).hidden = !visible;
      any ||= Boolean(visible);
    });
    empty.hidden = any;
    history.replaceState(null, '', on ? '#available' : location.pathname);
  }

  button.addEventListener('click', () => {
    apply(button.getAttribute('aria-pressed') !== 'true');
    // If the list is already scrolled, start again from its first year
    const first = works.querySelector('.year:not([hidden])');
    if (first && first.getBoundingClientRect().top < 0) first.scrollIntoView();
  });
  if (location.hash === '#available') apply(true);

  // The year in the bar follows the scroll: the year on screen is underlined
  const links = new Map([...document.querySelectorAll('.years a')].map((a) => [a.getAttribute('href').slice(1), a]));
  const spy = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      links.forEach((a) => a.removeAttribute('aria-current'));
      links.get(entry.target.id)?.setAttribute('aria-current', 'true');
    });
  }, { rootMargin: '-30% 0px -65% 0px' });
  works.querySelectorAll('.year').forEach((section) => spy.observe(section));
</script>

<style>
  .intro { padding-block: var(--space-xl) var(--space-m); }

  /* Sticky bar right under the header: solid, so the works scrolling under it never show through */
  .toolbar {
    position: sticky; top: var(--bar); z-index: 4;
    background: var(--wall);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-m); height: var(--toolbar); }

  /* "Available only": quiet text like the years; underlined while on */
  .filter {
    display: inline-flex; align-items: center; gap: var(--space-2xs);
    padding: var(--space-2xs) 0; border: 0; background: none;
    color: var(--muted); font: inherit; font-size: var(--text-xs); letter-spacing: var(--tracking); text-transform: uppercase; white-space: nowrap;
    cursor: pointer;
  }
  .filter:hover, .filter[aria-pressed='true'] { color: var(--ink); }
  .filter .dot { width: .4rem; height: .4rem; border-radius: 50%; background: var(--available); }

  .bar :global(.years a[hidden]) { display: none; }
  .only-available :global(li:has([data-status]:not([data-status='available']))) { display: none; }

  /* A jump to a year leaves the same space above its title as between years */
  .year { padding-top: var(--space-xl); scroll-margin-top: calc(var(--bar) + var(--toolbar) - var(--space-xl) + var(--space-l)); }
  .count { font-size: var(--text-xs); color: var(--muted); }

  .empty { padding-block: var(--space-xl); color: var(--muted); }

  @media (max-width: 767px) {
    .bar { overflow-x: auto; scrollbar-width: none; }
    .bar::-webkit-scrollbar { display: none; }
    .bar :global(.years) { flex-wrap: nowrap; }
    .filter { order: -1; }
  }
</style>
