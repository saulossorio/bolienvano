---
// One exhibition: title and facts, the first photo large, the text in a readable
// column, then the works that were shown folded in a disclosure (closed by default,
// so they never interrupt the reading), and the other photos. Every photo opens the viewer.
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Viewer from '../../components/Viewer.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import { t, exhibitionTexts } from '../../content/index.js';
import { exhibitions } from '../../data/exhibitions.js';
import { artworks } from '../../data/artworks.js';
import { pageUrl } from '../../lib/urls.js';
import { image, largeUrl } from '../../lib/images.js';
import { formatDate } from '../../lib/dates.js';

export function getStaticPaths() {
  return exhibitions.map((exhibition) => ({ params: { slug: exhibition.slug }, props: { exhibition } }));
}

const { exhibition } = Astro.props;
const text = exhibitionTexts[exhibition.slug];
const photos = await Promise.all(
  exhibition.photos.map(async (name, i) => {
    const src = image('exhibitions', name);
    return { src, large: await largeUrl(src), alt: `${text.title} — ${t.exhibitions.photo} ${i + 1}` };
  }),
);
const [first, ...rest] = photos;
const works = (exhibition.works ?? []).map((slug) => artworks.find((a) => a.slug === slug));
---
<Base title={text.title} description={text.summary} path={`exhibitions/${exhibition.slug}`} current="exhibitions" image={first.src}>
  <div class="container">
    <header class="intro">
      <a class="eyebrow back" href={pageUrl('exhibitions')}>← {t.exhibitions.title}</a>
      <h1>{text.title}</h1>
      <p class="facts">
        <time datetime={exhibition.date}>{formatDate(exhibition.date)}</time>
        <span>{text.venue}</span>
      </p>
    </header>

    <a class="zoomable hero" href={first.large} data-zoom="photos" data-caption={first.alt}>
      <Picture
        src={first.src}
        alt={first.alt}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[700, 1100, 1440]}
        sizes="(max-width: 1360px) 92vw, 1264px"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <div class="body">
      {text.body.map((p) => <p set:html={p} />)}
    </div>

    {works.length > 0 && (
      <details class="works">
        <summary>
          <span>{t.exhibitions.seeWorks.replace('{n}', works.length)}</span>
          <span class="sign" aria-hidden="true"></span>
        </summary>
        <div class="works-body">
          <WorkGrid items={works} />
          {exhibition.nft && (
            <p class="nft">{t.exhibitions.nftAlso} <a href={pageUrl('gallery/hiperconciente')}>{t.nft.title}</a></p>
          )}
        </div>
      </details>
    )}

    {rest.length > 0 && (
      <div class:list={['photos', { single: rest.length === 1 }]}>
        {rest.map((photo) => (
          <a class="zoomable" href={photo.large} data-zoom="photos" data-caption={photo.alt}>
            <Picture
              src={photo.src}
              alt={photo.alt}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[600, 900, 1440]}
              sizes="(max-width: 767px) 92vw, 46vw"
              loading="lazy"
            />
          </a>
        ))}
      </div>
    )}
  </div>
  <Viewer />
</Base>

<style>
  .intro { padding-block: clamp(3rem, 7vw, 6rem) clamp(1.5rem, 3vw, 2.5rem); }
  .back { text-decoration: none; }
  .back:hover { color: var(--ink); }
  .intro h1 { margin-bottom: 1rem; }
  .facts { display: flex; flex-wrap: wrap; gap: .25rem 1.5rem; margin: 0; color: var(--muted); }

  .zoomable { display: block; overflow: hidden; cursor: zoom-in; }
  .zoomable :global(img) { width: 100%; transition: transform var(--slow) var(--ease); }
  .zoomable:hover :global(img) { transform: scale(1.015); }
  .hero :global(img) { max-height: 85svh; object-fit: cover; }

  /* Text in a comfortable reading width */
  .body { max-width: 42rem; padding-block: clamp(3rem, 6vw, 5rem); font-size: 1.0625rem; line-height: 1.75; }
  .body p:first-child { font-size: 1.25rem; line-height: 1.6; }

  /* Works shown: one quiet line until opened; opens and closes smoothly */
  .works { margin-bottom: clamp(3rem, 6vw, 5rem); border-block: 1px solid var(--line); interpolate-size: allow-keywords; }
  .works summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding-block: 1.5rem; cursor: pointer; list-style: none;
    font-family: var(--display); font-size: clamp(1.25rem, 2.5vw, 1.75rem); line-height: 1.2;
    transition: color var(--fast) var(--ease);
  }
  .works summary::-webkit-details-marker { display: none; }
  .works summary:hover { color: var(--accent); }
  .sign { position: relative; flex: none; width: 1.25rem; height: 1.25rem; }
  .sign::before, .sign::after {
    content: ''; position: absolute; inset: 50% 0 auto; height: 1.5px; margin-top: -.75px;
    background: currentColor; transition: transform var(--fast) var(--ease);
  }
  .sign::after { transform: rotate(90deg); }
  .works[open] .sign::after { transform: rotate(0); }
  .works::details-content {
    block-size: 0; overflow: clip; opacity: 0;
    transition: block-size var(--slow) var(--ease), opacity var(--slow) var(--ease), content-visibility var(--slow) allow-discrete;
  }
  .works[open]::details-content { block-size: auto; opacity: 1; }
  .works-body { padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3rem, 6vw, 5rem); }
  .nft { margin: clamp(3rem, 6vw, 5rem) 0 0; font-family: var(--display); font-size: 1.25rem; }

  .photos { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(.75rem, 1.5vw, 1.25rem); }
  .photos.single { grid-template-columns: 1fr; }
  .photos :global(img) { aspect-ratio: 3 / 2; object-fit: cover; }

  @media (max-width: 767px) {
    .photos { grid-template-columns: 1fr; }
  }
</style>
