---
// One exhibition: photo slider, date, venue and text.
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { t, exhibitionTexts } from '../../content/index.js';
import { exhibitions } from '../../data/exhibitions.js';
import { image } from '../../lib/images.js';
import { formatDate } from '../../lib/dates.js';

export function getStaticPaths() {
  return exhibitions.map((exhibition) => ({ params: { slug: exhibition.slug }, props: { exhibition } }));
}

const { exhibition } = Astro.props;
const text = exhibitionTexts[exhibition.slug];
const photos = exhibition.photos.map((name) => image('exhibitions', name));
---
<Base title={text.title} description={text.summary} path={`exhibitions/${exhibition.slug}`} current="exhibitions" image={photos[0]}>
  <section class="section">
    <div class="container">
      <div class="slider" data-slider>
        <ul class="track" data-track>
          {photos.map((src, i) => (
            <li class="slide" id={`photo-${i + 1}`}>
              <Picture
                src={src}
                alt={`${text.title} — ${t.exhibitions.photo} ${i + 1}`}
                formats={['avif']}
                fallbackFormat="webp"
                widths={[640, 960, 1440]}
                sizes="(max-width: 767px) 100vw, 940px"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            </li>
          ))}
        </ul>
        {photos.length > 1 && (
          <>
            <button class="arrow prev" type="button" data-step="-1" aria-label={t.exhibitions.previous}>‹</button>
            <button class="arrow next" type="button" data-step="1" aria-label={t.exhibitions.next}>›</button>
            <div class="dots">
              {photos.map((_, i) => (
                <a href={`#photo-${i + 1}`} aria-label={`${t.exhibitions.photo} ${i + 1}`} aria-current={i === 0 ? 'true' : undefined}></a>
              ))}
            </div>
          </>
        )}
      </div>

      <h1 class="title">{text.title}</h1>
      <p class="when">
        <time datetime={exhibition.date}>{formatDate(exhibition.date)}</time><br />
        {text.venue}
      </p>
      <div class="body">
        {text.body.map((p) => <p set:html={p} />)}
      </div>
    </div>
  </section>
</Base>

<script>
  // Slider: the photos scroll horizontally (swipe works natively);
  // arrows and dots move between them and the current dot follows the scroll.
  document.querySelectorAll('[data-slider]').forEach((slider) => {
    const track = slider.querySelector('[data-track]');
    const dots = [...slider.querySelectorAll('.dots a')];
    const count = track.children.length;
    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i) => track.scrollTo({ left: ((i + count) % count) * track.clientWidth });

    slider.querySelectorAll('[data-step]').forEach((button) =>
      button.addEventListener('click', () => go(current() + Number(button.dataset.step))),
    );
    dots.forEach((dot, i) =>
      dot.addEventListener('click', (e) => { e.preventDefault(); go(i); }),
    );
    track.addEventListener('scrollend', () =>
      dots.forEach((dot, i) => dot.toggleAttribute('aria-current', i === current())),
    );
  });
</script>

<style>
  .slider { position: relative; height: 28rem; margin-bottom: 2rem; }

  .track {
    display: flex; height: 100%;
    margin: 0; padding: 0; list-style: none;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar { display: none; }
  .slide { flex: 0 0 100%; scroll-snap-align: start; }
  .slide :global(picture), .slide :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }

  .arrow {
    position: absolute; top: 50%; translate: 0 -50%;
    width: 48px; height: 48px;
    border: 0; background: none; color: var(--white);
    font-size: 2.5rem; line-height: 1; cursor: pointer;
    text-shadow: 0 0 6px rgb(0 0 0 / 50%);
  }
  .prev { left: .5rem; }
  .next { right: .5rem; }

  .dots {
    position: absolute; left: 0; right: 0; bottom: 1rem;
    display: flex; justify-content: center; gap: .75rem;
  }
  .dots a {
    width: 10px; height: 10px; border-radius: 50%;
    background: rgb(255 255 255 / 40%);
  }
  .dots a[aria-current] { background: var(--white); }

  .title { font-size: 2rem; }
  .when { margin: 0; }
  .body { padding-top: 2rem; }

  @media (max-width: 991px) {
    .slider { height: 20rem; }
  }
  @media (max-width: 767px) {
    .slider { height: 10rem; }
  }
</style>
