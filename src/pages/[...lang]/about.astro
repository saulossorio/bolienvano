---
// About, structured like the CV pages of established artists: the name, a short
// biography in the third person, then the CV as dated lists.
// No portrait: the works represent the artist. One reading column.
// Solo exhibitions come from src/data/exhibitions.js, the rest from src/data/cv.js.
import Base from '../../layouts/Base.astro';
import { useTexts } from '../../content/index.js';
import { exhibitions } from '../../data/exhibitions.js';
import { projects } from '../../data/cv.js';
import { artworkImages } from '../../lib/images.js';
import { artistId } from '../../lib/schema.js';
import { langParams } from '../../lib/urls.js';
const { t, exhibitionTexts, url, lang } = useTexts(Astro);

export const getStaticPaths = () => langParams().map((params) => ({ params }));

// Picture shown when the page is shared: a work, not a portrait
const shareImage = artworkImages('invisible')[0].src;

// The venue, then its city and country, on lines of their own under an entry (.place)
const place = ({ venue, city, country }) =>
  venue ? `<span class="place"><span>${venue}</span><span class="city">${city}, ${country}</span></span>` : '';

const sections = [
  {
    title: t.about.solo,
    rows: exhibitions.map((e) => ({
      year: e.date.slice(0, 4),
      html: `<em>${exhibitionTexts[e.slug].title}</em>` + place(exhibitionTexts[e.slug]),
      href: url(`exhibitions/${e.slug}`),
    })),
  },
  {
    title: t.about.projects,
    rows: projects.map((p) => {
      const inLang = (v) => (typeof v === 'object' ? v[lang] : v);
      return { year: p.year, html: inLang(p.text) + place({ venue: inLang(p.venue), city: p.city, country: inLang(p.country) }), href: p.link && url(p.link) };
    }),
  },
].filter((s) => s.rows.length);
---
<Base title={t.about.title} description={t.about.paragraphs[0]} path="about" current="about" image={shareImage} schema={[{ '@type': 'ProfilePage', mainEntity: { '@id': artistId(Astro.site) } }]}>
  <div class="container about">
    <div class="text">
      <header class="head">
        <h1>{t.site.name}</h1>
      </header>

      <div class="bio">
        {t.about.paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <section class="cv" aria-labelledby="cv">
        <h2 id="cv" class="visually-hidden">{t.about.cv}</h2>
        {sections.map((s) => (
          <div class="cv-section">
            <h3>{s.title}</h3>
            <ul>
              {s.rows.map((r) => (
                <li>
                  <span class="year">{r.year}</span>
                  {r.href ? <a href={r.href} set:html={r.html} /> : <span set:html={r.html} />}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    </div>
  </div>
</Base>

<style>
  .about { padding-block: var(--space-xl) 0; }
  .text { max-width: 44rem; }
  .head h1 { margin: 0; }

  .bio { margin-top: var(--space-l); font-size: var(--text-md); line-height: 1.7; color: var(--prose); }
  .bio p { margin: 0 0 var(--space-s); }

  /* CV: a small title per section, then year | entry rows between thin lines */
  .cv { margin-top: var(--space-xl); }
  .cv-section + .cv-section { margin-top: var(--space-l); }
  .cv h3 {
    margin: 0 0 var(--space-xs);
    font-family: var(--sans); font-size: var(--text-xs); font-weight: 500;
    letter-spacing: var(--tracking); text-transform: uppercase; color: var(--muted);
  }
  .cv ul { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .cv li {
    display: grid; grid-template-columns: 4.5rem 1fr; gap: var(--space-s);
    padding-block: var(--space-s); border-bottom: 1px solid var(--line);
    font-size: var(--text-sm); line-height: 1.5;
  }
  .year { color: var(--muted); font-variant-numeric: tabular-nums; }
  .cv a { display: block; text-decoration: none; }
  .cv .place { margin-top: var(--space-3xs); }
  .cv a:hover { text-decoration: underline; text-underline-offset: .2em; }

</style>
