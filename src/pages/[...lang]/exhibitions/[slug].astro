---
// One exhibition: title and facts, the main photo and the text, then two collapsible
// sections with fixed names — Works (the works shown) and Installation views (all the
// photos) — closed by default so they never interrupt the reading. A link to #works
// opens that section. Every photo opens the viewer.
import { Picture } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Viewer from '../../../components/Viewer.astro';
import WorkGrid from '../../../components/WorkGrid.astro';
import { useTexts } from '../../../content/index.js';
import { exhibitions } from '../../../data/exhibitions.js';
import { artworks } from '../../../data/artworks.js';
import { image, largeUrl, shareUrl } from '../../../lib/images.js';
import { exhibitionSchema } from '../../../lib/schema.js';
import { langParams } from '../../../lib/urls.js';
const { t, exhibitionTexts, date, url, lang } = useTexts(Astro);

export function getStaticPaths() {
  return langParams().flatMap(({ lang }) => exhibitions.map((exhibition) => ({ params: { lang, slug: exhibition.slug }, props: { exhibition } })));
}

const { exhibition } = Astro.props;
const text = exhibitionTexts[exhibition.slug];
const photos = await Promise.all(
  exhibition.photos.map(async (name, i) => {
    const src = image('exhibitions', name);
    return { src, large: await largeUrl(src), alt: `${text.title} — ${t.exhibitions.photo} ${i + 1}` };
  }),
);
const [first] = photos;
const schema = [exhibitionSchema(exhibition, Astro.site, await shareUrl(first.src, Astro.site), lang)];
const works = (exhibition.works ?? []).map((slug) => artworks.find((a) => a.slug === slug));
---
<Base title={text.title} description={text.summary} path={`exhibitions/${exhibition.slug}`} current="exhibitions" image={first.src} schema={schema}>
  <div class="container">
    <header class="intro">
      <a class="eyebrow back" href={url('exhibitions')}>← {t.exhibitions.title}</a>
      <h1>{text.title}</h1>
      <p class="facts">
        <time datetime={exhibition.date}>{date(exhibition.date)}</time>
        <span class="place"><span>{text.venue}</span><span class="city">{text.city}, {text.country}</span></span>
      </p>
    </header>

    <section class="overview">
      <a class="zoomable hero" href={first.large} data-zoom="hero" data-caption={first.alt}>
        <Picture
          src={first.src}
          alt={first.alt}
          formats={['avif']}
          fallbackFormat="webp"
          widths={[700, 1100, 1440]}
          sizes="(max-width: 1360px) 92vw, 1264px"
          loading="eager"
          fetchpriority="high"
        />
      </a>
      <div class="body">
        {text.body.map((p) => <p set:html={p} />)}
      </div>
    </section>

    {works.length > 0 && (
      <details class="fold" id="works">
        <summary><h2>{t.exhibitions.works}</h2><span class="sign" aria-hidden="true"></span></summary>
        <div class="fold-body">
          <WorkGrid items={works} />
          {exhibition.nft && (
            <p class="nft">{t.exhibitions.nftAlso}: <a href={url('gallery/hiperconciente')}>{t.nft.title}</a></p>
          )}
        </div>
      </details>
    )}

    <details class="fold" id="views">
      <summary><h2>{t.exhibitions.views}</h2><span class="sign" aria-hidden="true"></span></summary>
      <div class:list={['photos', { single: photos.length === 1 }]}>
        {photos.map((photo) => (
          <a class="zoomable" href={photo.large} data-zoom="photos" data-caption={photo.alt}>
            <Picture
              src={photo.src}
              alt={photo.alt}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[600, 900, 1440]}
              sizes="(max-width: 767px) 92vw, 46vw"
              loading="lazy"
            />
          </a>
        ))}
      </div>
    </details>
  </div>
  <Viewer />
</Base>

<script>
  // A link to #works or #views (e.g. "Exhibited in" on an artwork page) opens that section.
  const target = location.hash && document.querySelector<HTMLDetailsElement>(`details${location.hash}`);
  if (target) { target.open = true; target.scrollIntoView(); }
</script>

<style>
  .intro { padding-block: var(--space-xl) var(--space-l); }
  .back { text-decoration: none; }
  .back:hover { color: var(--ink); }
  .intro h1 { margin-bottom: var(--space-s); }
  /* One line: date, venue, city, each apart (a thin line between them); on phones,
     where they do not fit, one under the other, close together */
  .facts { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-3xs) 0; margin: 0; color: var(--muted); }
  .facts .place { display: contents; }
  .facts > *, .facts .place > span { display: inline-flex; align-items: baseline; }
  .facts > * + *::before, .facts .place > span + span::before {
    content: ''; align-self: center; width: 1px; height: .9em; margin-inline: var(--space-s); background: var(--line);
  }
  .facts .place > span:first-child { color: var(--ink); }
  @media (max-width: 599px) {
    .facts { flex-direction: column; align-items: flex-start; gap: var(--space-3xs); }
    .facts > * + *::before, .facts .place > span + span::before { display: none; }
  }

  /* Collapsible sections: fixed names, a plus that turns into a minus, smooth open */
  .fold { border-bottom: 1px solid var(--line); interpolate-size: allow-keywords; scroll-margin-top: var(--bar); }
  .overview + .fold { margin-top: var(--space-2xl); border-top: 1px solid var(--line); }
  .fold summary {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-s);
    padding-block: var(--space-l); cursor: pointer; list-style: none;
  }
  .fold summary::-webkit-details-marker { display: none; }
  .fold h2 { margin: 0; font-size: var(--text-2xl); }
  .sign { position: relative; flex: none; width: 1.25rem; height: 1.25rem; }
  .sign::before, .sign::after {
    content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; margin-top: -.75px;
    background: var(--ink); transition: transform var(--fast) var(--ease);
  }
  .sign::after { transform: rotate(90deg); }
  .fold summary:hover .sign::after { transform: rotate(90deg) scaleX(.6); }
  .fold[open] .sign::after { transform: rotate(0) scaleX(0); }
  .fold::details-content {
    block-size: 0; overflow: clip; opacity: 0;
    transition: block-size var(--slow) var(--ease), opacity var(--slow) var(--ease), content-visibility var(--slow) allow-discrete;
  }
  .fold[open]::details-content { block-size: auto; opacity: 1; }
  .fold-body, .fold .photos { padding-block: var(--space-m) var(--space-xl); }

  .zoomable { display: block; overflow: hidden; cursor: zoom-in; }
  .zoomable :global(img) { width: 100%; transition: transform var(--slow) var(--ease); }
  .zoomable:hover :global(img) { transform: scale(1.015); }
  .hero :global(img) { max-height: calc(100svh - var(--bar) - var(--space-l)); object-fit: cover; }

  /* Text in a comfortable reading width */
  .body { max-width: 42rem; padding-top: var(--space-xl); font-size: var(--text-md); line-height: 1.75; font-family: var(--text); color: var(--prose); }

  .nft { margin: var(--space-xl) 0 0; color: var(--muted); }
  .nft a { color: var(--ink); }

  .photos { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-s); }
  .photos.single { grid-template-columns: 1fr; }
  .photos :global(img) { aspect-ratio: 3 / 2; object-fit: cover; }

  @media (max-width: 767px) {
    .photos { grid-template-columns: 1fr; }
  }
</style>
