---
// certificate/<slug>.html: the certificate of authenticity of one artwork, always in
// the same format and filled in from src/data/artworks.js (title, year, technique,
// size, number, photo). On screen it is a sheet of paper on the wall; printed (or
// saved as PDF from the print dialog) it is one A4 page, signed by hand.
// The QR code leads back to this page, so anyone holding the paper can check it.
// When the certificate is registered on the Bitcoin blockchain (src/data/timestamps.js),
// the sheet says so in one line and, below it, the page says in words what each record
// holds (authorship, then each change of ownership) and checks them against Bitcoin in the
// visitor's browser (src/lib/ots.js). The files and manual steps stay folded for experts.
// Internal: not in the menu or the sitemap, hidden from search engines.
import { getImage } from 'astro:assets';
import QRCode from 'qrcode';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import Base from '../../../layouts/Base.astro';
import { useTexts, texts } from '../../../content/index.js';
import { artworks } from '../../../data/artworks.js';
import { timestamps } from '../../../data/timestamps.js';
import { artworkImages } from '../../../lib/images.js';
import { langParams, assetUrl } from '../../../lib/urls.js';
const { t, artworkTitles, url, date } = useTexts(Astro);

export function getStaticPaths() {
  return langParams().flatMap(({ lang }) => artworks.map((artwork) => ({ params: { lang, slug: artwork.slug }, props: { artwork } })));
}

const { artwork } = Astro.props;
const c = t.certificate;
const title = artworkTitles[artwork.slug];
const path = `certificate/${artwork.slug}`;
const link = new URL(url(path), Astro.site);
const photo = await getImage({ src: artworkImages(artwork.slug)[0].src, width: 1200, format: 'webp', quality: 85 });
const qr = await QRCode.toString(link.href, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#1d1c1aff', light: '#0000' } });
const statement = c.statement.replace('{title}', `<em>${title}</em>`);

// Blockchain records: each registered text, what it says in words, its SHA-256, and links
// to it and its proof. The build stops if an authorship record and the artwork data differ.
const english = texts('en').t;
const field = (text, name) => text.match(new RegExp(`^${name}: (.*)$`, 'm'))?.[1];
const records = (timestamps[artwork.coa] ?? []).map((r) => {
  const text = readFileSync(`public/certificate/proof/${r.file}.txt`);
  const fields = text.toString();
  if (r.kind === 'authorship') {
    const expected = { Certificate: artwork.coa, Year: String(artwork.year), Medium: english.media[artwork.medium], Size: artwork.size };
    for (const [name, value] of Object.entries(expected)) {
      if (field(fields, name) !== value) throw new Error(`${r.file}.txt: ${name} is "${field(fields, name)}", the artwork says "${value}"`);
    }
  }
  const words = r.kind === 'sale'
    ? c.saleWords.replace('{from}', field(fields, 'From')).replace('{date}', date(field(fields, 'Date')))
    : c.authorshipWords.replace('{artist}', field(fields, 'Artist')).replace('{title}', `<em>${title}</em>`)
        .replace('{details}', [artwork.year, t.media[artwork.medium].toLowerCase(), artwork.size, c.unique.split(',')[0].toLowerCase()].join(', ')).replace('{coa}', `<span class="coa">${artwork.coa}</span>`);
  return {
    ...r,
    title: r.kind === 'sale' ? c.sale : c.authorship,
    words,
    text: fields,
    hash: createHash('sha256').update(text).digest('hex'),
    record: assetUrl(`certificate/proof/${r.file}.txt`),
    ots: assetUrl(`certificate/proof/${r.file}.ots`),
  };
});
const proof = records[0];
const status = (r) => r.block ? `${c.block} ${r.block.toLocaleString(t.locale)} · ${date(r.date)}` : c.pending;
// Before checking: the block, with a link to it on the best known explorer
const blockLink = (height) => `https://www.blockchain.com/explorer/blocks/btc/${height}`;
// Texts the checker writes, in this language
const checkTexts = { locale: t.locale, verifying: c.verifying, verifiedTitle: c.verifiedTitle, block: c.block, confirmedBy: c.confirmedBy, mismatch: c.mismatch, offline: c.offline, again: c.verifyNow, newTab: t.a11y.newTab };
---
<Base title={`${c.title}, ${title}`} path={path} noindex>
  <div class="container page">

    <article class="sheet">
      <header class="head">
        <p class="eyebrow">{c.title}</p>
        <p class="number"><span>{c.number}</span> <span class="numeral">{artwork.coa}</span></p>
      </header>

      <div class="body">
        <img class="photo" src={photo.src} alt={title} fetchpriority="high" width={photo.attributes.width} height={photo.attributes.height} />

        <div class="text">
          <h1>{title}</h1>
          <dl class="facts">
            <div><dt>{c.artist}</dt><dd>{t.site.name}</dd></div>
            <div><dt>{c.year}</dt><dd class="numeral">{artwork.year}</dd></div>
            <div><dt>{c.technique}</dt><dd>{t.media[artwork.medium]}</dd></div>
            <div><dt>{c.size}</dt><dd>{artwork.size}</dd></div>
            <div><dt>{c.edition}</dt><dd>{c.unique}</dd></div>
          </dl>
        </div>
      </div>

      <p class="statement" set:html={statement} />

      <div class="sign">
        <div class="field wide"><span class="line" /><span class="eyebrow">{c.owner}</span></div>
        <div class="field"><span class="line" /><span class="eyebrow">{c.ownerCode}</span></div>
        <div class="field"><span class="line" /><span class="eyebrow">{c.date}</span></div>
        <div class="field wide"><span class="line" /><span class="eyebrow">{c.signature}, {t.site.name}</span></div>
      </div>

      <footer class="foot">
        <div class="qr" set:html={qr} />
        <p>
          {c.verify}<br /><span class="url">{link.host}{link.pathname}</span><br />
          {proof && <><span class="chain">{c.chain} · {status(proof)}</span><br /></>}
          <span class="note">{c.note}</span>
        </p>
      </footer>
    </article>

    {proof && (
      <section class="check" aria-labelledby="check">
        <h2 id="check" class="eyebrow">{c.checkTitle}</h2>
        <p class="lead">{c.chainIntro}</p>
        <p class="verify" hidden data-verify-box>
          <button class="more check-now" type="button" data-verify data-texts={JSON.stringify(checkTexts)}>{c.verifyNow}</button>
          <span>{c.verifyIntro}</span>
        </p>
        {records.map((r) => (
          <div class="said" data-entry data-record={r.record} data-ots={r.ots}>
            <p><strong>{r.title}.</strong> <span set:html={r.words} /></p>
            <p class="result" data-result aria-live="polite">
              {c.chain} · {r.block
                ? <>{date(r.date)} · {c.block} {r.block.toLocaleString(t.locale)}, <a class="line-link" href={blockLink(r.block)} target="_blank" rel="noopener">{c.viewOn} Blockchain.com<span class="visually-hidden"> ({t.a11y.newTab})</span></a></>
                : c.pending}
            </p>
          </div>
        ))}
        <details>
        <summary>{c.howTo}</summary>
        <div class="how">
        <p>{c.checkIntro}</p>
        <ol>{c.checkSteps.map((step) => <li set:html={step} />)}</ol>
        {records.some((r) => r.kind === 'sale') && <p>{c.ownerNote}</p>}
        {records.map((r) => (
          <div class="entry">
            <h3>{r.title}</h3>
            <pre class="record">{r.text}</pre>
            <p class="files">
              <a class="line-link" href={r.record} download>{c.record}</a>
              <a class="line-link" href={r.ots} download>{c.proof}</a>
            </p>
          </div>
        ))}
        </div>
        </details>
      </section>
    )}

    <button class="button outline print" type="button" hidden data-print>{c.print}</button>
  </div>
</Base>

<script>
  import { readProof, explorers } from '../../../lib/ots.js';

  // The print button needs JavaScript, so it only shows when it works
  const button = document.querySelector('[data-print]');
  button.hidden = false;
  button.addEventListener('click', () => print());

  // "Verify now": every record is checked against Bitcoin, in this browser
  const verify = document.querySelector('[data-verify]');
  if (verify) {
    document.querySelector('[data-verify-box]').hidden = false;
    const x = JSON.parse(verify.dataset.texts);
    const blocks = {};   // each block is asked once, even if several records share it
    const ask = (height) => blocks[height] ??= Promise.allSettled(explorers.map((e) => e.get(height)));
    const when = (time) => new Intl.DateTimeFormat(x.locale, { dateStyle: 'long', timeStyle: 'short', timeZone: 'UTC' }).format(time * 1000) + ' UTC';
    const linkTo = (e, hash) => `<a class="line-link" href="${e.link(hash)}" target="_blank" rel="noopener">${e.name}<span class="visually-hidden"> (${x.newTab})</span></a>`;

    async function check(entry) {
      const result = entry.querySelector('[data-result]');
      result.className = 'result';
      result.textContent = x.verifying;
      try {
        const [record, ots] = await Promise.all([entry.dataset.record, entry.dataset.ots].map(async (u) => new Uint8Array(await (await fetch(u, { cache: 'no-store' })).arrayBuffer())));
        const found = await readProof(record, ots);
        const block = found?.[0];
        if (!block) { result.className = 'result bad'; result.textContent = x.mismatch; return; }
        const answers = await ask(block.height);
        const agree = answers.map((a, k) => a.status === 'fulfilled' && a.value.root === block.root ? { e: explorers[k], ...a.value } : null).filter(Boolean);
        const disagree = answers.some((a) => a.status === 'fulfilled' && a.value.root !== block.root);
        if (disagree) { result.className = 'result bad'; result.textContent = x.mismatch; return; }
        if (!agree.length) { result.className = 'result bad'; result.textContent = x.offline; return; }
        result.className = 'result good';
        result.innerHTML = `<svg class="mark" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="lines"><strong>${x.verifiedTitle}</strong><span>${when(agree[0].time)} · ${x.block} ${block.height.toLocaleString(x.locale)}</span><span class="by">${x.confirmedBy} ${agree.map((a) => linkTo(a.e, a.hash)).join(' · ')}</span></span>`;
      } catch {
        result.className = 'result bad';
        result.textContent = x.offline;
      }
    }

    verify.addEventListener('click', async () => {
      verify.disabled = true;
      await Promise.all([...document.querySelectorAll('[data-entry]')].map(check));
      verify.disabled = false;
    });
  }
</script>

<style>
  .page { display: grid; justify-items: center; gap: var(--space-m); padding-block: var(--space-l) var(--space-xl); }
  .print[hidden] { display: none; }

  /* An A4 sheet: white paper, always light, whatever the site theme */
  .sheet {
    --ink: #1d1c1a; --muted: #6b6863; --line: #dcd9d3;
    color-scheme: light;
    display: flex; flex-direction: column; gap: 7mm;
    width: min(100%, 210mm); aspect-ratio: 210 / 297;
    padding: clamp(1.25rem, 6%, 16mm);
    background: #fff; color: var(--ink);
    box-shadow: var(--sheet-shadow);
  }

  .head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-s); padding-bottom: 4mm; border-bottom: 1px solid var(--line); }
  .head .eyebrow { margin: 0; color: var(--ink); }
  .number { margin: 0; font-size: var(--text-xs); color: var(--muted); }
  .number .numeral { color: var(--ink); white-space: nowrap; }

  .body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 8mm; align-items: start; }
  .photo { width: 100%; height: auto; max-height: 110mm; object-fit: contain; object-position: left top; }
  h1 { margin: 0 0 5mm; font-size: clamp(1.5rem, 3.4vw, 2.1rem); }
  .facts { margin: 0; display: grid; gap: 2.5mm; }
  .facts div { display: grid; gap: .1rem; }
  .facts dt { font-size: var(--text-xs); letter-spacing: var(--tracking); text-transform: uppercase; color: var(--muted); }
  .facts dd { margin: 0; font-size: var(--text-sm); }

  .statement { margin: 0; font-size: var(--text-sm); line-height: 1.7; }

  /* Lines to fill in by hand, pushed to the bottom of the sheet. The owner code is the
     secret code of the sale record on the blockchain (src/data/timestamps.js) */
  .sign { margin-top: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 9mm 8mm; }
  .field { display: grid; gap: 1.5mm; }
  .field.wide { grid-column: 1 / -1; }
  .line { height: 10mm; border-bottom: 1px solid var(--ink); }
  .field .eyebrow { margin: 0; }

  .foot { display: flex; align-items: center; gap: 5mm; padding-top: 4mm; border-top: 1px solid var(--line); }
  .qr { flex: none; width: 20mm; }
  .qr :global(svg) { display: block; width: 100%; height: auto; }
  .foot p { margin: 0; font-size: var(--text-xs); line-height: 1.6; color: var(--muted); }
  .url { color: var(--ink); overflow-wrap: anywhere; }

  /* How to check the blockchain record: on screen only, under the sheet */
  .check { min-width: 0; width: min(100%, 210mm); display: grid; gap: var(--space-2xs); font-size: var(--text-sm); color: var(--muted); }
  .check h2 { margin: 0; color: var(--ink); }
  .check p, .check ol { margin: 0; }
  .said { display: grid; gap: var(--space-3xs); padding-block: var(--space-xs); border-bottom: 1px solid var(--line); }
  .said p:first-child { color: var(--ink); }
  .said strong { font-weight: 500; }
  .said :global(.coa) { white-space: nowrap; }
  /* The confirmation stands apart from the text: a soft green note that settles in, never
     a white card (it would look like part of the sheet). Green as for available works. */
  .result { transition: color var(--fast) var(--ease); }
  .result.good {
    display: flex; gap: var(--space-2xs); align-items: flex-start;
    margin-top: var(--space-3xs); padding: var(--space-xs) var(--space-s);
    border-left: 2px solid var(--available);
    background: color-mix(in srgb, var(--available) 7%, transparent);
    color: var(--ink);
    animation: settle var(--slow) var(--ease) both;
  }
  @keyframes settle { from { opacity: 0; transform: translateY(.35rem); } }
  .result :global(.mark) { flex: none; width: 1em; height: 1em; margin-top: .3em; color: var(--available); }
  .result :global(.lines) { display: grid; gap: .1rem; }
  .result :global(strong) { font-weight: 500; color: var(--available); }
  .result.bad { color: var(--accent); }
  .result :global(.by) { color: var(--muted); }
  .lead { color: var(--ink); }
  .verify { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-3xs) var(--space-s); margin-bottom: var(--space-2xs) !important; }
  .check-now { padding: 0; border: 0; background: none; color: var(--ink); font-family: inherit; cursor: pointer; }
  .check-now::after { margin-left: .35em; }
  .check-now:disabled { color: var(--muted); cursor: default; }
  .verify[hidden] { display: none; }
  details summary { cursor: pointer; width: fit-content; margin-top: var(--space-2xs); font-weight: 500; color: var(--ink); }
  .how { display: grid; gap: var(--space-2xs); margin-top: var(--space-s); }
  .entry { display: grid; gap: var(--space-2xs); margin-top: var(--space-s); }
  .entry h3 { margin: 0; font-family: var(--sans); font-size: var(--text-sm); font-weight: 500; color: var(--ink); }
  .entry h3 span { font-weight: 400; color: var(--muted); }
  .record { overflow-wrap: anywhere; margin: 0; padding: var(--space-s); border: 1px solid var(--line); font: inherit; font-size: var(--text-xs); line-height: 1.6; color: var(--ink); white-space: pre-wrap; }
  .check ol { padding-left: 1.2em; display: grid; gap: var(--space-3xs); }
  .files { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-m); color: var(--ink); }

  /* Phone: no fixed paper shape, everything in one column */
  @media (max-width: 599px) {
    .sheet { aspect-ratio: auto; }
    .body { grid-template-columns: 1fr; }
  }

  /* Printed: only the sheet, on one A4 page, with the page margins inside it */
  @page { size: A4; margin: 0; }
  @media print {
    :global(.navbar), :global(.footer), :global(.cookies), :global(.skip-link), .print, .check { display: none !important; }
    :global(body) { background: #fff; }
    .page { padding: 0; }
    .sheet { width: 210mm; height: 297mm; aspect-ratio: auto; padding: 16mm; box-shadow: none; }
    .body { grid-template-columns: 1fr 1fr; }
  }
</style>
