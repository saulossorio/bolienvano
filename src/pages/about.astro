---
// About, structured like the CV pages of established artists: the name and one line
// of facts, a short biography in the third person, then the CV as dated lists.
// Solo exhibitions come from src/data/exhibitions.js, the rest from src/data/cv.js.
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { t, exhibitionTexts } from '../content/index.js';
import { exhibitions } from '../data/exhibitions.js';
import { projects } from '../data/cv.js';
import { pageUrl } from '../lib/urls.js';
import { image } from '../lib/images.js';
import { artistId } from '../lib/schema.js';

const photo = image('site', 'perfil-andys.jpg');

const sections = [
  {
    title: t.about.solo,
    rows: exhibitions.map((e) => ({
      year: e.date.slice(0, 4),
      html: `<em>${exhibitionTexts[e.slug].title}</em>, ${exhibitionTexts[e.slug].venue}`,
      href: pageUrl(`exhibitions/${e.slug}`),
    })),
  },
  {
    title: t.about.projects,
    rows: projects.map((p) => ({ year: p.year, html: p.text, href: p.link && pageUrl(p.link) })),
  },
].filter((s) => s.rows.length);
---
<Base title={t.about.title} description={t.about.paragraphs[0]} path="about" current="about" image={photo} schema={[{ '@type': 'ProfilePage', mainEntity: { '@id': artistId(Astro.site) } }]}>
  <div class="container about">
    <div class="photo">
      <Picture
        src={photo}
        alt={t.about.photoAlt}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[400, 700, 1000]}
        sizes="(max-width: 899px) 60vw, 30vw"
        loading="eager"
      />
    </div>

    <div class="text">
      <header class="head">
        <h1>{t.site.name}</h1>
        <p class="facts">{t.about.facts}</p>
      </header>

      <div class="bio">
        {t.about.paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <section class="cv" aria-labelledby="cv">
        <h2 id="cv" class="visually-hidden">{t.about.cv}</h2>
        {sections.map((s) => (
          <div class="cv-section">
            <h3>{s.title}</h3>
            <ul>
              {s.rows.map((r) => (
                <li>
                  <span class="year">{r.year}</span>
                  {r.href ? <a href={r.href} set:html={r.html} /> : <span set:html={r.html} />}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    </div>
  </div>
</Base>

<style>
  /* Portrait in a narrow column that stays in view; text in a reading column */
  .about {
    display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--space-xl); align-items: start;
    padding-block: var(--space-xl) 0;
  }
  .photo { position: sticky; top: calc(var(--bar) + var(--space-m)); }
  .photo :global(img) {
    width: 100%; aspect-ratio: 4 / 5; object-fit: cover;
    mix-blend-mode: darken;   /* the white photo background turns wall-colored */
    max-height: calc(100svh - var(--bar) - var(--space-xl) - var(--space-m));
  }

  .text { max-width: 40rem; }
  .head h1 { margin-bottom: var(--space-2xs); }
  .facts { margin: 0; color: var(--muted); }

  .bio { margin-top: var(--space-l); font-size: var(--text-md); line-height: 1.7; }
  .bio p { margin: 0 0 var(--space-s); }

  /* CV: a small title per section, then year | entry rows between thin lines */
  .cv { margin-top: var(--space-xl); }
  .cv-section + .cv-section { margin-top: var(--space-l); }
  .cv h3 {
    margin: 0 0 var(--space-xs);
    font-family: var(--sans); font-size: var(--text-xs); font-weight: 500;
    letter-spacing: .1em; text-transform: uppercase; color: var(--muted);
  }
  .cv ul { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .cv li {
    display: grid; grid-template-columns: 4.5rem 1fr; gap: var(--space-s);
    padding-block: var(--space-s); border-bottom: 1px solid var(--line);
    font-size: var(--text-sm); line-height: 1.5;
  }
  .year { color: var(--muted); font-variant-numeric: tabular-nums; }
  .cv a { text-decoration: none; }
  .cv a:hover { text-decoration: underline; text-underline-offset: .2em; }

  @media (max-width: 899px) {
    .about { grid-template-columns: 1fr; gap: var(--space-l); }
    .photo { position: static; max-width: 18rem; }
  }
</style>
