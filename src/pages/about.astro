---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { t } from '../content/index.js';
import { image } from '../lib/images.js';

const photo = image('site', 'perfil-andys.jpg');
---
<Base title={t.about.title} description={t.about.paragraphs[0]} path="about" current="about" image={photo}>
  <section class="section about">
    <div class="container grid">
      <Picture
        src={photo}
        alt={t.about.photoAlt}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[360, 720]}
        sizes="(max-width: 767px) 50vw, 360px"
        class="photo"
        loading="eager"
      />
      <div class="text">
        <h1 class="visually-hidden">{t.about.title}</h1>
        {t.about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .about { display: flex; align-items: center; justify-content: center; min-height: 70vh; }
  .grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;
    align-items: center;
  }
  .grid :global(picture) { display: flex; justify-content: center; }
  .grid :global(.photo) { max-height: 360px; width: auto; object-fit: contain; }

  @media (max-width: 767px) {
    .grid { grid-template-columns: 1fr; }
    .grid :global(.photo) { max-width: 50%; }
  }
</style>
