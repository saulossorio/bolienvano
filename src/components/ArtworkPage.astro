---
// One artwork: the framed photo as large as the screen allows, the two close-up
// details right under it, and the museum label beside them. Every image opens
// the full-screen viewer with zoom. Links to the previous and next works at the end.
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Viewer from './Viewer.astro';
import Availability from './Availability.astro';
import { t, artworkTitles, exhibitionTexts } from '../content/index.js';
import { artworks } from '../data/artworks.js';
import { exhibitions } from '../data/exhibitions.js';
import { pageUrl } from '../lib/urls.js';
import { artworkImages, largeUrl, shareUrl } from '../lib/images.js';
import { artworkSchema } from '../lib/schema.js';

const { artwork } = Astro.props;
const title = artworkTitles[artwork.slug];
const medium = t.media[artwork.medium];
const images = await Promise.all(
  artworkImages(artwork.slug).map(async (img) => ({
    ...img,
    large: await largeUrl(img.src),
    alt: `${title}, ${img.kind === 'mockup' ? t.artwork.view : t.artwork.detail}`,
  })),
);
const [view, ...details] = images;
const shownIn = exhibitions.filter((e) => e.works?.includes(artwork.slug));

// Previous / next in gallery order
const index = artworks.findIndex((a) => a.slug === artwork.slug);
const prev = artworks[index - 1];
const next = artworks[index + 1];
const schema = [artworkSchema(artwork, Astro.site, await shareUrl(view.src, Astro.site))];
---
<Base
  title={title}
  description={`${title} (${artwork.year}). ${medium}, ${artwork.size}. ${t.site.name}`}
  path={`gallery/${artwork.slug}`}
  current="gallery"
  image={view.src}
  schema={schema}
>
  <div class="container">
    <article class="work">
      <div class="images">
        <a class="zoomable view" href={view.large} data-zoom="work" data-caption={view.alt}>
          <Picture
            src={view.src}
            alt={view.alt}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[600, 900, 1200]}
            sizes="(max-width: 899px) 92vw, 62vw"
            loading="eager"
            fetchpriority="high"
          />
          <span class="hint" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7" /></svg>
          </span>
        </a>

        <div class="details">
          {details.map((img) => (
            <a class="zoomable" href={img.large} data-zoom="work" data-caption={img.alt}>
              <Picture
                src={img.src}
                alt={img.alt}
                formats={['avif']}
                fallbackFormat="webp"
                widths={[400, 700, 1000]}
                sizes="(max-width: 899px) 46vw, 31vw"
                loading="lazy"
              />
              <span class="hint" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7" /></svg>
              </span>
            </a>
          ))}
        </div>
      </div>

      <div class="label">
        <a class="eyebrow back" href={pageUrl(`gallery/${artwork.year}`)}>← {t.artwork.back} {artwork.year}</a>
        <h1>{title}</h1>
        <dl class="facts">
          <div><dt>{t.artwork.year}</dt><dd>{artwork.year}</dd></div>
          <div><dt>{t.artwork.technique}</dt><dd>{medium}</dd></div>
          <div><dt>{t.artwork.size}</dt><dd>{artwork.size}</dd></div>
          {shownIn.map((e) => (
            <div><dt>{t.exhibitions.exhibitedIn}</dt><dd><a href={`${pageUrl(`exhibitions/${e.slug}`)}#works`}>{exhibitionTexts[e.slug].title}</a>, {e.date.slice(0, 4)}</dd></div>
          ))}
        </dl>
        <Availability artwork={artwork} title={title} />
      </div>
    </article>

    <nav class="pager" aria-label={t.gallery.title}>
      {prev ? (
        <a class="prev" href={pageUrl(`gallery/${prev.slug}`)}>
          <span class="eyebrow">← {t.artwork.previous}</span>
          <span class="name">{artworkTitles[prev.slug]}</span>
        </a>
      ) : <span />}
      {next && (
        <a class="next" href={pageUrl(`gallery/${next.slug}`)}>
          <span class="eyebrow">{t.artwork.next} →</span>
          <span class="name">{artworkTitles[next.slug]}</span>
        </a>
      )}
    </nav>
  </div>
  <Viewer />
</Base>

<style>
  .work {
    display: grid; grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr);
    gap: var(--space-xl); align-items: start;
    padding-top: var(--space-l);
  }

  /* Images: the main one as tall as the screen, details in two columns */
  .images { display: grid; gap: var(--space-s); }
  .zoomable { position: relative; display: block; overflow: hidden; cursor: zoom-in; background: var(--wall); }
  .zoomable :global(img) { width: 100%; transition: transform var(--slow) var(--ease); }
  .zoomable:hover :global(img) { transform: scale(1.015); }
  .view :global(img) {
    max-height: calc(100svh - var(--bar) - var(--space-l) * 2); object-fit: contain;
    mix-blend-mode: darken;   /* white photo backgrounds turn wall-colored */
  }
  .details { display: grid; grid-template-columns: 1fr 1fr; gap: inherit; }
  .details :global(img) { aspect-ratio: 1; object-fit: cover; }

  /* Small "expand" badge, more visible on hover and keyboard focus */
  .hint {
    position: absolute; right: .75rem; bottom: .75rem;
    display: grid; place-items: center;
    width: 2.5rem; height: 2.5rem; border-radius: 50%;
    background: rgb(242 241 239 / 85%); color: var(--ink);
    opacity: .7; transition: opacity var(--fast) var(--ease);
  }
  .hint svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .zoomable:hover .hint, .zoomable:focus-visible .hint { opacity: 1; }


  .label { position: sticky; top: calc(var(--bar) + var(--space-l)); }
  .back { text-decoration: none; }
  .back:hover { color: var(--ink); }
  .label h1 { font-size: var(--text-3xl); margin-bottom: var(--space-m); }

  .facts { margin: 0 0 var(--space-m); border-top: 1px solid var(--line); }
  .facts div {
    display: grid; grid-template-columns: 6.5rem 1fr; gap: var(--space-s);
    padding-block: var(--space-xs); border-bottom: 1px solid var(--line);
  }
  .facts dt { font-size: var(--text-xs); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); padding-top: var(--space-3xs); }
  .facts dd { margin: 0; }

  .pager {
    display: flex; justify-content: space-between; gap: var(--space-l);
    margin-top: var(--space); padding-top: var(--space-l);
    border-top: 1px solid var(--line);
  }
  .pager a { text-decoration: none; }
  .pager .next { text-align: right; }
  .pager .eyebrow { margin-bottom: var(--space-3xs); }
  .pager .name { font-family: var(--display); font-size: var(--text-2xl); line-height: 1.1; }
  .pager a:hover .name { text-decoration: underline; text-decoration-thickness: 1px; }

  @media (max-width: 899px) {
    .work { grid-template-columns: 1fr; }
    .label { position: static; }
    .view :global(img) { max-height: none; }
  }
</style>
