---
// Row of year links. On the works page they jump down the page; elsewhere they
// open the year page. Props: current (year being shown, optional), anchors (bool)
import { t } from '../content/index.js';
import { years } from '../data/artworks.js';
import { pageUrl } from '../lib/urls.js';

const { current, anchors = false } = Astro.props;
---
<nav class="years" aria-label={t.gallery.jump}>
  {years.map(({ year }) => (
    <a
      href={anchors ? `#y${year}` : pageUrl(`gallery/${year}`)}
      aria-current={year === current ? 'page' : undefined}
    >{year}</a>
  ))}
</nav>

<style>
  /* Quiet text links, like the main menu: a thin line under the current year */
  .years { display: flex; flex-wrap: wrap; gap: var(--space-m); }
  .years a {
    position: relative; padding-block: var(--space-2xs);
    font-size: var(--text-xs); letter-spacing: .1em; font-variant-numeric: tabular-nums;
    color: var(--muted); text-decoration: none;
    transition: color var(--fast) var(--ease);
  }
  .years a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: .2rem; height: 1px; background: currentColor;
    transform: scaleX(0); transform-origin: left; transition: transform var(--fast) var(--ease);
  }
  .years a:hover, .years a[aria-current] { color: var(--ink); }
  .years a[aria-current]::after { transform: scaleX(1); }
</style>
