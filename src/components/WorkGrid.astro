---
// Grid of artwork cards: 3 columns on desktop, 2 on tablet, 1 on phones.
// priority: the first card is the page's main image (top of the Works page).
import WorkCard from './WorkCard.astro';

const { items, eagerCount = 3, priority = false } = Astro.props;
---
<ul class="grid">
  {items.map((a, i) => <li><WorkCard artwork={a} eager={i < eagerCount} priority={priority && i === 0} /></li>)}
</ul>

<style>
  .grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl) var(--space-l);
    margin: 0; padding: 0; list-style: none;
  }
  @media (max-width: 1023px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 599px)  { .grid { grid-template-columns: 1fr; } }
</style>
