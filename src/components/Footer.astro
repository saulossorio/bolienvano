---
// Footer: one quiet line: social links and credits. No email address in the page
// (spam bots harvest it); people write through the contact form.
// "Privacy" explains the cookies and the contact form, and lets visitors change their cookie choice.
import { useTexts } from '../content/index.js';
import { socials } from '../data/socials.js';
const { t, url } = useTexts(Astro);

const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="bottom">
      <ul class="socials">
        {socials.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener noreferrer">
              {s.name}<span class="visually-hidden"> ({t.a11y.newTab})</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="credits">
        <a href={url('privacy')}>{t.nav.privacy}</a>
        © {year} {t.site.name}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer { margin-top: var(--space); border-top: 1px solid var(--line); }

  .bottom {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-s);
    padding-block: var(--space-m) var(--space-l);
    font-size: var(--text-xs); color: var(--muted);
  }
  .socials { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-m); margin: 0; padding: 0; list-style: none; }
  .socials a { color: var(--ink); text-decoration: none; }
  .socials a:hover { text-decoration: underline; }

  .credits { display: flex; gap: var(--space-m); margin: 0; }
  .credits a { text-decoration: none; }
  .credits a:hover { color: var(--ink); }
  .credits a:hover { text-decoration: underline; }
</style>
