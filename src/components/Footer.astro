---
// Footer: invitation to get in touch, social links, credits.
import { t } from '../content/index.js';
import { pageUrl } from '../lib/urls.js';
import { socials } from '../data/socials.js';

const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="cta">
      <p class="cta-text">{t.footer.cta}</p>
      <a class="button" href={pageUrl('contact')}>{t.footer.ctaLink}</a>
    </div>

    <div class="bottom">
      <ul class="socials">
        {socials.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener noreferrer">
              {s.name}<span class="visually-hidden"> ({t.a11y.newTab})</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="credits">© {year} {t.site.name}</p>
    </div>
  </div>
</footer>

<style>
  .footer { margin-top: var(--space); border-top: 1px solid var(--line); }

  .cta {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-s) var(--space-l);
    padding-block: var(--space-xl);
  }
  .cta-text {
    margin: 0; max-width: 22ch;
    font-family: var(--display); font-size: var(--text-2xl); line-height: 1.1;
  }

  .bottom {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-s);
    padding-block: var(--space-m) var(--space-l);
    border-top: 1px solid var(--line);
    font-size: var(--text-xs); color: var(--muted);
  }
  .socials { display: flex; gap: var(--space-m); margin: 0; padding: 0; list-style: none; }
  .socials a { color: var(--ink); text-decoration: none; }
  .socials a:hover { text-decoration: underline; }

  .credits { margin: 0; }
  .credits a:hover { text-decoration: underline; }
</style>
