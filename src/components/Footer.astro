---
// Footer: invitation to get in touch, social links, credits.
import { t } from '../content/index.js';
import { pageUrl } from '../lib/urls.js';

const socials = [
  { name: 'Instagram', url: 'https://www.instagram.com/bolienvano/' },
  { name: 'Facebook',  url: 'https://www.facebook.com/bolienvano' },
  { name: 'TikTok',    url: 'https://www.tiktok.com/@bolienvano' },
];
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="cta">
      <p class="cta-text">{t.footer.cta}</p>
      <a class="button" href={pageUrl('contact')}>{t.footer.ctaLink}</a>
    </div>

    <div class="bottom">
      <ul class="socials">
        {socials.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener noreferrer">
              {s.name}<span class="visually-hidden"> ({t.a11y.newTab})</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="credits">© {year} {t.site.name}</p>
    </div>
  </div>
</footer>

<style>
  .footer { margin-top: var(--space); border-top: 1px solid var(--line); }

  .cta {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem 2rem;
    padding-block: 3.5rem;
  }
  .cta-text {
    margin: 0; max-width: 22ch;
    font-family: var(--display); font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: 1.1;
  }

  .bottom {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--line);
    font-size: .8125rem; color: var(--muted);
  }
  .socials { display: flex; gap: 1.5rem; margin: 0; padding: 0; list-style: none; }
  .socials a { color: var(--ink); text-decoration: none; }
  .socials a:hover { text-decoration: underline; }

  .credits { margin: 0; }
  .credits a:hover { text-decoration: underline; }
</style>
