---
// Footer: one quiet line: social links and credits. No email address in the page
// (spam bots harvest it); people write through the contact form.
// "Privacy" explains the cookies and the contact form, and lets visitors change their cookie choice.
// EN · ES · PT next to it: the same page in each language (from Base.astro); on phones
// they are in the menu instead (Header.astro).
import { useTexts } from '../content/index.js';
import { socials } from '../data/socials.js';
const { t, url } = useTexts(Astro);
const { alternates = [] } = Astro.props;
const names = { en: 'English', es: 'Español', pt: 'Português' };

const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="bottom">
      <ul class="socials">
        {socials.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener noreferrer">
              {s.name}<span class="visually-hidden"> ({t.a11y.newTab})</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="credits">
        {alternates.length > 0 && (
          <span class="langs" role="group" aria-label={t.nav.language}>
            {alternates.map((a) => (
              <a href={a.href} hreflang={a.lang} lang={a.lang} title={names[a.lang]}
                 aria-current={a.lang === t.lang ? 'true' : undefined} data-lang={a.lang}>{a.lang}</a>
            ))}
          </span>
        )}
        <a href={url('privacy')}>{t.nav.privacy}</a>
        © {year} {t.site.name}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer { margin-top: var(--space); border-top: 1px solid var(--line); }

  .bottom {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-s);
    padding-block: var(--space-m) var(--space-l);
    font-size: var(--text-xs); color: var(--muted);
  }
  .socials { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-m); margin: 0; padding: 0; list-style: none; }
  .socials a { color: var(--ink); text-decoration: none; }
  .socials a:hover { text-decoration: underline; }

  .credits { display: flex; gap: var(--space-m); margin: 0; }
  .credits a { text-decoration: none; }
  .credits a:hover { color: var(--ink); }
  .credits a:hover { text-decoration: underline; }

  /* Languages: EN ES PT, the current one in ink; on phones they are in the menu */
  .langs { display: flex; gap: var(--space-xs); text-transform: uppercase; letter-spacing: var(--tracking); }
  .langs a[aria-current] { color: var(--ink); }
  @media (max-width: 767px) { .langs { display: none; } }
</style>

<script>
  // Language switch (here and in the phone menu): remember the choice, so the
  // first-visit redirect in Base.astro never overrides it
  document.querySelectorAll('[data-lang]').forEach((a) => a.addEventListener('click', () => {
    try { localStorage.setItem('lang', a.dataset.lang); } catch {}
  }));
</script>
