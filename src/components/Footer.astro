---
import { t } from '../content/index.js';
import { assetUrl } from '../lib/urls.js';

const socials = [
  { name: 'Instagram', url: 'https://www.instagram.com/bolienvano/', icon: 'insta.svg' },
  { name: 'Facebook',  url: 'https://www.facebook.com/bolienvano',   icon: 'facebook.svg' },
  { name: 'TikTok',    url: 'https://www.tiktok.com/@bolienvano',    icon: 'tiktok.svg' },
];
---
<footer class="footer">
  <ul class="socials">
    {socials.map((s) => (
      <li>
        <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`${s.name} (${t.a11y.newTab})`}>
          <img src={assetUrl(s.icon)} alt="" width="32" height="32" loading="lazy" />
        </a>
      </li>
    ))}
  </ul>
  <p class="copyright">© 2022 <a href="https://agenciasierra.com" target="_blank" rel="noopener noreferrer">{t.site.credit}</a></p>
</footer>

<style>
  .footer { padding: 2rem; text-align: center; }

  .socials {
    display: flex; justify-content: center; gap: 1.5rem;
    max-width: var(--container); margin: 0 auto; padding: 0 0 2rem;
    list-style: none;
  }
  .socials a { display: block; transition: transform .2s ease; }
  .socials a:hover { transform: scale(1.1); }
  .socials img { width: 2rem; height: 2rem; object-fit: contain; }

  .copyright { margin: 0; color: var(--muted); }
  .copyright a { color: inherit; text-decoration: none; transition: color .2s ease; }
  .copyright a:hover { color: var(--link-hover); }
</style>
