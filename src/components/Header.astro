---
// Top bar: name on the left, four links on the right. The logo is the way home,
// so there is no "Home" link. Below 768px the links fold into a button that opens
// a native popover (no JavaScript; Esc or a tap outside closes it).
import { t } from '../content/index.js';
import { pageUrl } from '../lib/urls.js';

const { current } = Astro.props;

const links = [
  { id: 'gallery',     href: pageUrl('gallery'),     label: t.nav.gallery },
  { id: 'exhibitions', href: pageUrl('exhibitions'), label: t.nav.exhibitions },
  { id: 'about',       href: pageUrl('about'),       label: t.nav.about },
  { id: 'contact',     href: pageUrl('contact'),     label: t.nav.contact },
];
// The NFT page belongs to the works
const active = current === 'nft' ? 'gallery' : current;
---
<header class="navbar">
  <div class="bar container">
    <a class="logo" href={pageUrl('')} aria-current={current === 'home' ? 'page' : undefined}>{t.site.name}</a>

    <button class="menu-button" type="button" popovertarget="menu" aria-label={t.nav.menu}>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <nav id="menu" class="menu" popover aria-label={t.nav.menu}>
      {links.map((l) => (
        <a href={l.href} aria-current={l.id === active ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .navbar {
    position: sticky; top: 0; z-index: 5;
    background: color-mix(in srgb, var(--wall) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    view-transition-name: navbar;   /* stays still while the page crossfades */
  }
  .bar {
    display: flex; align-items: center; justify-content: space-between;
    min-height: 5rem;
  }

  .logo {
    font-family: var(--serif);
    font-size: 1.5rem; font-weight: 500; line-height: 1; letter-spacing: -.02em;
    text-decoration: none;
  }

  /* Desktop: the popover is shown inline as a normal row of links */
  .menu {
    position: static; display: flex; gap: 2.25rem;
    margin: 0; padding: 0; border: 0;
    background: none; color: inherit; overflow: visible;
  }
  .menu a {
    position: relative;
    padding-block: .5rem;
    font-size: .8125rem; font-weight: 500;
    letter-spacing: .1em; text-transform: uppercase;
    text-decoration: none;
  }
  /* Thin line under the current page and on hover */
  .menu a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: .2rem;
    height: 1px; background: currentColor;
    transform: scaleX(0); transform-origin: left;
    transition: transform var(--fast) var(--ease);
  }
  .menu a:hover::after, .menu a[aria-current='page']::after { transform: scaleX(1); }

  .menu-button { display: none; }

  @media (max-width: 767px) {
    .bar { min-height: 4rem; }
    .logo { font-size: 1.25rem; }

    .menu-button {
      display: flex; flex-direction: column; justify-content: center; gap: 7px;
      width: 44px; height: 44px; margin-right: -10px; padding: 10px;
      border: 0; background: none; cursor: pointer;
    }
    .menu-button span { height: 1.5px; background: var(--ink); transition: transform var(--fast) var(--ease); }
    .navbar:has(.menu:popover-open) .menu-button span:first-child { transform: translateY(4.25px) rotate(45deg); }
    .navbar:has(.menu:popover-open) .menu-button span:last-child  { transform: translateY(-4.25px) rotate(-45deg); }

    .menu {
      display: none;
      position: fixed; inset: 4rem 0 auto 0;
      width: 100%; padding: 1rem var(--gutter) 2rem;
      background: var(--wall);
      border-bottom: 1px solid var(--line);
    }
    .menu:popover-open { display: flex; flex-direction: column; gap: 0; }
    .menu a {
      padding-block: 1rem;
      font-family: var(--serif); font-size: 2rem; font-weight: 300;
      letter-spacing: -.02em; text-transform: none;
      border-bottom: 1px solid var(--line);
    }
    .menu a::after { display: none; }
    .menu a[aria-current='page'] { color: var(--muted); }
  }
</style>
