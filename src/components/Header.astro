---
// Top bar: name on the left, four links on the right. The logo is the way home,
// so there is no "Home" link. Below 768px the links fold into a button that opens
// a full-screen menu (native popover, no JavaScript; Esc or the close button
// closes it). It fades in and the links rise one after another.
// The round button next to the links switches between light and dark; it only
// shows with JavaScript, since it needs it to work.
import { t } from '../content/index.js';
import { pageUrl } from '../lib/urls.js';

const { current } = Astro.props;

const links = [
  { id: 'gallery',     href: pageUrl('gallery'),     label: t.nav.gallery },
  { id: 'exhibitions', href: pageUrl('exhibitions'), label: t.nav.exhibitions },
  { id: 'about',       href: pageUrl('about'),       label: t.nav.about },
  { id: 'contact',     href: pageUrl('contact'),     label: t.nav.contact },
];
// The NFT page belongs to the works
const active = current === 'nft' ? 'gallery' : current;
---
<header class="navbar">
  <div class="bar container">
    <a class="logo" href={pageUrl('')} aria-current={current === 'home' ? 'page' : undefined}>{t.site.name}</a>

    <div class="right">
    <nav id="menu" class="menu" popover aria-label={t.nav.menu}>
      <div class="menu-top">
        <a class="logo" href={pageUrl('')}>{t.site.name}</a>
        <button class="close" type="button" popovertarget="menu" popovertargetaction="hide" aria-label={t.nav.close}>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </div>
      <div class="links">
        {links.map((l, i) => (
          <a class="line-link" href={l.href} aria-current={l.id === active ? 'page' : undefined} style={`--i: ${i}`}>{l.label}</a>
        ))}
      </div>
    </nav>

    <button class="theme" type="button" aria-label={t.nav.theme} aria-pressed="false" data-theme-toggle>
      <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7" /><path d="M10 3a7 7 0 0 1 0 14z" /></svg>
    </button>

    <button class="menu-button" type="button" popovertarget="menu" aria-label={t.nav.menu}>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
    </div>
  </div>
</header>

<script>
  // Switch: flip what is showing now and remember it (Base.astro reads it back on
  // every page). The page crossfades into the new colors where the browser can.
  const root = document.documentElement;
  const button = document.querySelector('[data-theme-toggle]');
  const system = matchMedia('(prefers-color-scheme: dark)');
  const isDark = () => (root.dataset.theme ?? (system.matches ? 'dark' : 'light')) === 'dark';
  const sync = () => button.setAttribute('aria-pressed', String(isDark()));

  button.addEventListener('click', () => {
    const theme = isDark() ? 'light' : 'dark';
    const apply = () => { root.dataset.theme = theme; sync(); };
    if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.startViewTransition(apply);
    else apply();
    try { localStorage.setItem('theme', theme); } catch {}
  });
  system.addEventListener('change', sync);
  sync();
</script>

<style>
  .navbar {
    position: sticky; top: 0; z-index: 5;
    background: var(--wall);   /* solid: nothing shows through while scrolling */
    view-transition-name: navbar;   /* stays still while the page crossfades */
  }
  .bar {
    display: flex; align-items: center; justify-content: space-between;
    min-height: var(--bar);
  }

  .right { display: flex; align-items: center; gap: var(--space-m); }

  .logo {
    font-family: var(--display);
    font-size: var(--text-lg); font-weight: 400; line-height: 1; letter-spacing: -.01em;   /* Syne widens as it gets bolder; 400 keeps the titles' proportions */
    text-decoration: none;
  }

  /* Desktop: the popover is shown inline as a normal row of links */
  .menu {
    position: static; display: flex; gap: var(--space-l);
    margin: 0; padding: 0; border: 0;
    background: none; color: inherit; overflow: visible;
  }
  /* Thin line under the current page and on hover: .line-link in global.css */
  .menu a {
    padding-block: var(--space-2xs);
    font-size: var(--text-xs); font-weight: 500;
    letter-spacing: var(--tracking); text-transform: uppercase;
  }

  .menu-button, .menu-top { display: none; }

  /* Light / dark switch: a circle half filled with the text color */
  .theme { display: none; }
  :global(.js) .theme {
    display: grid; place-items: center;
    width: var(--target); height: var(--target); margin-right: -12px;
    padding: 0; border: 0; background: none; color: var(--ink); cursor: pointer;
  }
  .theme svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.5; transition: transform var(--slow) var(--ease); }
  .theme path { fill: currentColor; stroke: none; }
  .theme[aria-pressed='true'] svg { transform: rotate(180deg); }
  .theme:hover { color: var(--muted); }
  .links { display: contents; }

  @media (max-width: 767px) {
    .logo { font-size: var(--text-lg); }

    .right { gap: 0; }
    :global(.js) .theme { margin-right: 0; }

    .menu-button {
      display: flex; flex-direction: column; justify-content: center; gap: 7px;
      width: var(--target); height: var(--target); margin-right: -10px; padding: 10px;
      border: 0; background: none; cursor: pointer;
    }
    .menu-button span { height: 1.5px; background: var(--ink); }

    /* Full-screen menu */
    .menu {
      position: fixed; inset: 0;
      width: 100%; height: 100%; max-width: none; max-height: none;
      display: flex; flex-direction: column;
      padding: 0 var(--gutter) var(--space-l);
      background: var(--wall);
      opacity: 0;
      transition: opacity var(--slow) var(--ease),
                  display var(--slow) allow-discrete, overlay var(--slow) allow-discrete;
    }
    .menu:not(:popover-open) { display: none; }
    .menu:popover-open { opacity: 1; }
    @starting-style { .menu:popover-open { opacity: 0; } }
    :global(html:has(.menu:popover-open)) { overflow: hidden; }

    .menu-top {
      display: flex; align-items: center; justify-content: space-between;
      min-height: var(--bar);
    }
    /* Same name as in the bar behind, so nothing jumps when the menu opens */
    .menu-top .logo {
      padding: 0;
      font-family: var(--display); font-size: var(--text-lg); font-weight: 400;
      letter-spacing: -.01em; text-transform: none;
    }
    .menu-top .logo::after { display: none; }
    .close {
      position: relative; width: var(--target); height: var(--target); margin-right: -10px;
      border: 0; background: none; cursor: pointer;
    }
    .close span {
      position: absolute; left: 10px; right: 10px; top: 50%;
      height: 1.5px; background: var(--ink);
      transition: transform var(--slow) var(--ease);
    }
    .menu:popover-open .close span:first-child { transform: rotate(45deg); }
    .menu:popover-open .close span:last-child  { transform: rotate(-45deg); }
    @starting-style {
      .menu:popover-open .close span:first-child { transform: translateY(-4px); }
      .menu:popover-open .close span:last-child  { transform: translateY(4px); }
    }

    /* Large links, lots of air around them, rising in one after another */
    .links {
      display: flex; flex-direction: column; justify-content: center; gap: var(--space-2xs);
      flex: 1;
    }
    .links a {
      align-self: flex-start;
      padding-block: var(--space-2xs);
      font-family: var(--display); font-size: var(--text-4xl); font-weight: 400; line-height: 1.1;
      letter-spacing: -.03em; text-transform: none;
      opacity: 0; transform: translateY(1.25rem);
      transition: opacity var(--fast) var(--ease), transform var(--fast) var(--ease), color var(--fast) var(--ease);
    }
    /* Opening: slower, one link after another. Closing: all together, quickly */
    .menu:popover-open .links a {
      opacity: 1; transform: none;
      transition-duration: var(--slow);
      transition-delay: calc(var(--i) * 70ms + 100ms);
    }
    @starting-style { .menu:popover-open .links a { opacity: 0; transform: translateY(1.25rem); } }
    .links a::after { display: none; }
    .links a[aria-current='page'] { color: var(--muted); }

  }
</style>
