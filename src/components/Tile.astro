---
// A gallery cell: fixed-height box with an image cropped to fill it, linking somewhere.
// Every image gets the same box and crop, whatever its original size.
// Props: href, src (imported image), alt, label (optional text over the image), faded
import { Picture } from 'astro:assets';

const { href, src, alt, label, faded = false, eager = false } = Astro.props;
---
<a class:list={['tile', { faded }]} href={href}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif']}
    fallbackFormat="webp"
    widths={[480, 960]}
    sizes="(max-width: 767px) 100vw, 454px"
    loading={eager ? 'eager' : 'lazy'}
  />
  {label && <span class="label">{label}</span>}
</a>

<style>
  .tile {
    position: relative;
    display: flex; align-items: center; justify-content: center;
    height: 20rem; overflow: hidden;
    color: var(--text); text-decoration: none;
  }
  .tile :global(picture) { position: absolute; inset: 0; transition: opacity .2s ease; }
  .tile :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .tile:hover :global(picture) { opacity: .5; }

  /* Year covers: image faded behind the year, disappears on hover */
  .faded :global(picture) { opacity: .25; }
  .faded:hover :global(picture) { opacity: 0; }

  .label { position: relative; font-size: 2rem; }

  @media (max-width: 479px) {
    .tile { height: 15rem; }
  }
</style>
