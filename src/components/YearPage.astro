---
import Base from '../layouts/Base.astro';
import WorkGrid from './WorkGrid.astro';
import YearNav from './YearNav.astro';
import { t } from '../content/index.js';
import { artworks } from '../data/artworks.js';
import { pageUrl } from '../lib/urls.js';

const { year } = Astro.props;
const items = artworks.filter((a) => a.year === year);
---
<Base title={String(year)} description={`${t.gallery.yearCover} ${year} — ${t.gallery.description}`} path={`gallery/${year}`} current="gallery">
  <div class="container">
    <header class="intro">
      <a class="eyebrow back" href={pageUrl('gallery')}>← {t.gallery.title}</a>
      <h1>{year}</h1>
      <YearNav current={year} />
    </header>
    <WorkGrid items={items} />
  </div>
</Base>

<style>
  .intro { padding-block: var(--space-xl) var(--space-l); }
  .back { text-decoration: none; }
  .back:hover { color: var(--ink); }
</style>
