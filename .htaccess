# Server config for bolienvano.com (Hostinger, Apache/LiteSpeed).
# The build copies this file to the site root as-is.

RewriteEngine On

# www.bolienvano.com -> bolienvano.com (one address per page for search engines)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Pages of the old Webflow site that no longer exist
RewriteRule ^(error-404|error|style)\.html$ / [R=301,L]
RewriteRule ^gallery/(work|year)-page-model\.html$ /gallery.html [R=301,L]
RewriteRule ^exhibitions/exhibition-model-page\.html$ /exhibitions.html [R=301,L]

ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

# ── Security headers ─────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ── Caching ──────────────────────────────────────────────────
# Files in /_astro/ get a year of cache from their own .htaccess (their names change on every edit).
<IfModule mod_headers.c>
  # Pages and sitemap: always check for a newer version, so a deploy shows up right away
  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Icons, PDFs, robots.txt: one week
  <FilesMatch "\.(png|svg|webp|pdf|txt)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# ── Compression ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/xml
</IfModule>
